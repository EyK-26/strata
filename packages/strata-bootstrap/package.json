{
  "name": "@getstrata/bootstrap",
  "version": "0.2.35",
  "description": "Strata application bootstrap — HttpKernel, DI, web session helpers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EyK-26/strata.git",
    "directory": "packages/strata-bootstrap"
  },
  "exports": {
    ".": {
      "types": "./dist/bootstrap/public-api.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./applicationRegistry": {
      "types": "./dist/bootstrap/applicationRegistry.d.ts",
      "import": "./dist/entries/applicationRegistry.js",
      "default": "./dist/entries/applicationRegistry.js"
    },
    "./buildModuleRoutes": {
      "types": "./dist/bootstrap/buildModuleRoutes.d.ts",
      "import": "./dist/entries/buildModuleRoutes.js",
      "default": "./dist/entries/buildModuleRoutes.js"
    },
    "./buildWebModuleRoutes": {
      "types": "./dist/bootstrap/buildWebModuleRoutes.d.ts",
      "import": "./dist/entries/buildWebModuleRoutes.js",
      "default": "./dist/entries/buildWebModuleRoutes.js"
    },
    "./cache/modelCacheTags": {
      "types": "./dist/bootstrap/cache/modelCacheTags.d.ts",
      "import": "./dist/entries/cache/modelCacheTags.js",
      "default": "./dist/entries/cache/modelCacheTags.js"
    },
    "./config": {
      "types": "./dist/bootstrap/config.d.ts",
      "import": "./dist/entries/config.js",
      "default": "./dist/entries/config.js"
    },
    "./context": {
      "types": "./dist/bootstrap/context.d.ts",
      "import": "./dist/entries/context.js",
      "default": "./dist/entries/context.js"
    },
    "./contracts": {
      "types": "./dist/bootstrap/contracts.d.ts",
      "import": "./dist/entries/contracts.js",
      "default": "./dist/entries/contracts.js"
    },
    "./createWebRoutes": {
      "types": "./dist/bootstrap/createWebRoutes.d.ts",
      "import": "./dist/entries/createWebRoutes.js",
      "default": "./dist/entries/createWebRoutes.js"
    },
    "./createRoutes": {
      "types": "./dist/bootstrap/createRoutes.d.ts",
      "import": "./dist/entries/createRoutes.js",
      "default": "./dist/entries/createRoutes.js"
    },
    "./createSpaRoutes": {
      "types": "./dist/bootstrap/createSpaRoutes.d.ts",
      "import": "./dist/entries/createSpaRoutes.js",
      "default": "./dist/entries/createSpaRoutes.js"
    },
    "./dependencies": {
      "types": "./dist/bootstrap/dependencies.d.ts",
      "import": "./dist/entries/dependencies.js",
      "default": "./dist/entries/dependencies.js"
    },
    "./discoverModules": {
      "types": "./dist/bootstrap/discoverModules.d.ts",
      "import": "./dist/entries/discoverModules.js",
      "default": "./dist/entries/discoverModules.js"
    },
    "./health": {
      "types": "./dist/bootstrap/health.d.ts",
      "import": "./dist/entries/health.js",
      "default": "./dist/entries/health.js"
    },
    "./http/securedRouteModelBinding": {
      "types": "./dist/bootstrap/http/securedRouteModelBinding.d.ts",
      "import": "./dist/entries/http/securedRouteModelBinding.js",
      "default": "./dist/entries/http/securedRouteModelBinding.js"
    },
    "./httpKernel": {
      "types": "./dist/bootstrap/httpKernel.d.ts",
      "import": "./dist/entries/httpKernel.js",
      "default": "./dist/entries/httpKernel.js"
    },
    "./listeners/invalidateCacheOnModelWrite": {
      "types": "./dist/bootstrap/listeners/invalidateCacheOnModelWrite.d.ts",
      "import": "./dist/entries/listeners/invalidateCacheOnModelWrite.js",
      "default": "./dist/entries/listeners/invalidateCacheOnModelWrite.js"
    },
    "./membershipService": {
      "types": "./dist/bootstrap/membershipService.d.ts",
      "import": "./dist/entries/membershipService.js",
      "default": "./dist/entries/membershipService.js"
    },
    "./metricsRoutes": {
      "types": "./dist/bootstrap/metricsRoutes.d.ts",
      "import": "./dist/entries/metricsRoutes.js",
      "default": "./dist/entries/metricsRoutes.js"
    },
    "./queue/defaultJobs": {
      "types": "./dist/bootstrap/queue/defaultJobs.d.ts",
      "import": "./dist/entries/queue/defaultJobs.js",
      "default": "./dist/entries/queue/defaultJobs.js"
    },
    "./providers": {
      "types": "./dist/bootstrap/providers/index.d.ts",
      "import": "./dist/entries/providers.js",
      "default": "./dist/entries/providers.js"
    },
    "./providers/view": {
      "types": "./dist/bootstrap/providers/view/index.d.ts",
      "import": "./dist/entries/providers/view.js",
      "default": "./dist/entries/providers/view.js"
    },
    "./routeRegistry": {
      "types": "./dist/bootstrap/routeRegistry.d.ts",
      "import": "./dist/entries/routeRegistry.js",
      "default": "./dist/entries/routeRegistry.js"
    },
    "./schedule": {
      "types": "./dist/bootstrap/schedule.d.ts",
      "import": "./dist/entries/schedule.js",
      "default": "./dist/entries/schedule.js"
    },
    "./secretsGuard": {
      "types": "./dist/bootstrap/secretsGuard.d.ts",
      "import": "./dist/entries/secretsGuard.js",
      "default": "./dist/entries/secretsGuard.js"
    },
    "./web/forms": {
      "types": "./dist/bootstrap/web/forms.d.ts",
      "import": "./dist/entries/web/forms.js",
      "default": "./dist/entries/web/forms.js"
    },
    "./web/routing": {
      "types": "./dist/bootstrap/web/routing.d.ts",
      "import": "./dist/entries/web/routing.js",
      "default": "./dist/entries/web/routing.js"
    },
    "./web/server": {
      "types": "./dist/bootstrap/web/server.d.ts",
      "import": "./dist/entries/web/server.js",
      "default": "./dist/entries/web/server.js"
    },
    "./web/session": {
      "types": "./dist/bootstrap/web/session.d.ts",
      "import": "./dist/entries/web/session.js",
      "default": "./dist/entries/web/session.js"
    },
    "./web/slug": {
      "types": "./dist/bootstrap/web/slug.d.ts",
      "import": "./dist/entries/web/slug.js",
      "default": "./dist/entries/web/slug.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/bootstrap/public-api.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:bundle && bun run build:shims && bun run build:subpaths && bun run build:types",
    "build:bundle": "bun build index.ts --outdir dist --target bun --external bun --external eta --external @getstrata/core",
    "build:types": "tsc -p tsconfig.types.json && bun ../../scripts/prune-bootstrap-dist-types.ts",
    "prepublishOnly": "bun run build",
    "build:subpaths": "bun build entries/applicationRegistry.ts entries/buildModuleRoutes.ts entries/buildWebModuleRoutes.ts entries/cache/modelCacheTags.ts entries/config.ts entries/context.ts entries/contracts.ts entries/createWebRoutes.ts entries/createRoutes.ts entries/createSpaRoutes.ts entries/dependencies.ts entries/discoverModules.ts entries/health.ts entries/http/securedRouteModelBinding.ts entries/httpKernel.ts entries/listeners/invalidateCacheOnModelWrite.ts entries/membershipService.ts entries/metricsRoutes.ts entries/queue/defaultJobs.ts entries/providers.ts entries/providers/view.ts entries/routeRegistry.ts entries/schedule.ts entries/secretsGuard.ts entries/web/forms.ts entries/web/routing.ts entries/web/server.ts entries/web/session.ts entries/web/slug.ts --outdir dist --root . --target bun --external bun --external eta --external @getstrata/core",
    "build:shims": "true"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@getstrata/core": "^0.5.33",
    "typescript": "^5.9.0"
  }
}
