{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "../../src",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "paths": {
      "@getstrata/core": ["../../src/framework/public-api.ts"],
      "@getstrata/core/*": ["../../src/core/*"],
      "@getstrata/bootstrap": ["../../src/bootstrap/public-api.ts"],
      "@getstrata/bootstrap/*": ["../../src/bootstrap/*"],
      "#strata-orm-internal": ["../../src/core/database/ormInternal.ts"],
      "#strata-orm-runtime": ["../../src/core/database/ormRuntime.ts"],
      "#strata-http-route": ["../../src/bootstrap/ownedHttpRoute.ts"],
      "#strata-job-discovery": ["../../src/bootstrap/jobDiscoveryState.ts"],
      "#strata-test-state": ["../../src/core/testingState.ts"],
      "#strata-mysql-native": ["../../src/core/database/mysqlNative.ts"]
    }
  },
  "include": ["../../src/bootstrap/public-api.ts", "../../src/bootstrap/**/*.ts"]
}
