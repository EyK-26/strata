{
  "name": "@getstrata/cli",
  "version": "0.1.0",
  "description": "Strata CLI — migrate, queue:work, make:* scaffolding",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EyK-26/strata.git",
    "directory": "packages/strata-cli"
  },
  "bin": {
    "strata": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build cli.ts --outdir dist --target bun --external bun --external eta --external @getstrata/core",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@getstrata/core": "^0.5.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
