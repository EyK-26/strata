DATABASE_URL=postgresql://postgres:dev-postgres-change-me@localhost:5432/{{PROJECT_NAME}}
PORT=3000
APP_URL=http://localhost:3000
# Opt-in for HTTPS termination with a preserved public Host; does not trust forwarding headers.
# CSRF_TARGET_ORIGIN=https://app.example.com
APP_ENV=local
APP_NAME={{PROJECT_NAME}}
# Cookie/Redis namespace. Unset defaults to `strata`.
# APP_KEY_PREFIX={{PROJECT_NAME}}
FRONTEND_MODE=api
# SPA_PREFIX=/app
TENANCY_DRIVER=none

# Required in production when FRONTEND_MODE=server-htmx or hybrid
# SESSION_SECRET=

# Set only behind a trusted reverse proxy
# TRUST_FORWARDED_FOR=true

# Required in production to expose GET /metrics
# METRICS_TOKEN=

# Production should set FEATURE_PUBLIC_READS=false
# FEATURE_PUBLIC_READS=false
