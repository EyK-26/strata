# Host-native overrides. Copy to .env.host and source before running Bun on the machine
# (while Postgres/Redis run in Docker Compose with published ports).
#
# Usage:
#   cp .env.host.example .env.host
#   set -a && source .env.host && set +a
#   bun run dev:host
#
# Or use the wrapper scripts (recommended):
#   bun run dev:host
#   bun run validate:host

DATABASE_URL=postgresql://postgres:postgres@localhost:54329/bun_testing_test
REDIS_URL=redis://localhost:6379
# MYSQL_URL=mysql://strata:strata@localhost:33061/strata
CACHE_DRIVER=redis
QUEUE_DRIVER=sync
SKIP_FIXTURE_TEST_BOOTSTRAP=1
