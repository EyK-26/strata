# Host-native overrides. Copy to .env.host and source before running Bun on the machine
# (while Postgres/Redis run in Docker Compose with published ports).
#
# Usage:
#   cp .env.host.example .env.host
#   set -a && source .env.host && set +a
#   bun run dev:host
#
# Or use the wrapper scripts (recommended):
#   bun run dev:host
#   bun run validate:host

DATABASE_URL=postgresql://postgres:dev-postgres-change-me@localhost:54329/bun_testing_test
# Superuser for CREATE ROLE / CREATE DATABASE / GRANT / migrate / migrate:fresh DROP.
MIGRATION_DATABASE_URL=postgresql://postgres:dev-postgres-change-me@localhost:54329/hiroapp_test
# HiroApp request traffic. FORCE RLS applies because strata_app is NOBYPASSRLS.
APP_DATABASE_URL=postgresql://strata_app:dev-strata-app-change-me@localhost:54329/hiroapp_test
REDIS_URL=redis://:dev-redis-change-me@localhost:6379
SESSION_SECRET=dev-session-secret-change-me-please-32ch
# MYSQL_URL=mysql://strata:dev-mysql-change-me@localhost:33061/strata
CACHE_DRIVER=redis
QUEUE_DRIVER=sync
SKIP_FIXTURE_TEST_BOOTSTRAP=1
