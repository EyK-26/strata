{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!!**/docs/openapi.json",
			"!!**/sdk/typescript/client.ts",
			"!!**/htmx.min.js"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"domains": {
			"test": "recommended"
		},
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"enabled": false
	}
}
