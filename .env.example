# Environment template for WorkHub
#
# Docker Compose (app container): use service hostnames below (postgres, redis).
# Host-native Bun against published ports: see .env.host.example or `bun run dev:host`.

# --- Core (all tiers) ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bun_testing_test
PORT=3000
APP_ENV=local
APP_DEBUG=true
APP_NAME=WorkHub
APP_URL=http://localhost:3000
API_PREFIX=/api/v1

# --- Frontend mode ---
# api          — JSON API only (default)
# server-htmx  — Eta templates + HTMX web routes
# spa-react      — Vite + React SPA served from /app/*
FRONTEND_MODE=api

# --- Web sessions (server-htmx) ---
# Required in production when FRONTEND_MODE=server-htmx
# SESSION_SECRET=change-me-in-production
# SESSION_COOKIE_NAME=workhub_session
# CSRF_COOKIE_NAME=workhub_csrf
# FLASH_COOKIE_NAME=workhub_flash
# Redis/cache/queue/throttle key namespace (sibling apps should set this)
# APP_KEY_PREFIX=workhub
# Optional HMAC secret for temporarySignedUrl (falls back to SESSION_SECRET)
# SIGNED_URL_SECRET=change-me-in-production
# WEBHOOK_SIGNATURE_HEADER=x-workhub-signature

# --- Network / proxy ---
# Honor X-Forwarded-For / X-Real-IP only behind a trusted reverse proxy.
# TRUST_FORWARDED_FOR=true
# Protect /metrics. Required in production (the endpoint 404s without a token).
# METRICS_TOKEN=

# --- Cache & queue (hobby: sync + array; production: redis) ---
CACHE_DRIVER=redis
# CACHE_DRIVER=array
CACHE_TTL_MS=3600000
CACHE_MAX_ENTRIES=100
REDIS_URL=redis://redis:6379
QUEUE_DRIVER=redis
# QUEUE_DRIVER=sync
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000

# --- Auth (hobby / dev) ---
AUTH_DEV_HEADERS=true
ADMIN_API_TOKEN=workhub-admin-test-token
MEMBER_API_TOKEN=workhub-member-test-token

# --- Auth (production — rotate all defaults) ---
# AUTH_DEV_HEADERS=false
# APP_ENV=production
# APP_DEBUG=false

# --- Feature flags (set false to disable modules) ---
FEATURE_WEBHOOKS=true
FEATURE_SEARCH=true
FEATURE_AUDIT_LOG=true
FEATURE_OAUTH=true
FEATURE_SAML=false
FEATURE_SCIM=true
FEATURE_BILLING=true
FEATURE_FIELD_ENCRYPTION=false
FEATURE_SIEM_EXPORT=true
FEATURE_PUBLIC_READS=true
FEATURE_EMAIL_VERIFICATION=false
FEATURE_MFA=false
FEATURE_ETAG=true

# --- API limits & CORS ---
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=120
# Login throttling: when APP_ENV=local defaults to 100 attempts / 60s.
# Production defaults to 5 attempts / 900s unless overridden below.
# LOGIN_RATE_LIMIT_PER_WINDOW=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
MAX_REQUEST_BODY_BYTES=1048576
# MAX_UPLOAD_BYTES=5242880
API_TOKEN_DEFAULT_EXPIRY_DAYS=
TOKEN_HASH_PEPPER=
OAUTH_STATE_SECRET=
SCIM_RATE_LIMIT_PER_MINUTE=60
STORAGE_PATH=storage
# STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET=
# AWS_REGION=
# AWS_ENDPOINT=

# --- Mail ---
# MAIL_DRIVER=log
# MAIL_DRIVER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
# MAIL_SECURE=false

# --- Database pool ---
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30
DB_POOL_MAX_LIFETIME=3600
DB_CONNECTION_TIMEOUT=10

# --- OAuth (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/github/callback
# OAUTH_STATE_SECRET=  # signs OAuth CSRF state cookie; defaults to ADMIN_API_TOKEN in dev
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# SAML_LOGIN_URL=

# --- Enterprise: SCIM provisioning ---
SCIM_BEARER_TOKEN=workhub-scim-test-token
# SCIM_TENANT_TOKENS=1:tenant-one-token,2:tenant-two-token

# --- Enterprise: field encryption (required when FEATURE_FIELD_ENCRYPTION=true in production) ---
# KMS_ENCRYPTION_KEY=

# --- Enterprise: observability ---
# Scheduler: external (default) runs `bun run cli schedule:run` from system cron.
# Set to `in-process-cron` to register Bun.cron() inside the app process.
# SCHEDULER_DRIVER=in-process-cron
# OTEL_SERVICE_NAME=workhub-api
# SIEM_EXPORT_URL=
# SIEM_EXPORT_TOKEN=
# SIEM_EXPORT_FORMAT=json

# --- Enterprise: billing integration stub ---
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
