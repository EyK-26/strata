# Environment template for HiroApp / Strata

# Docker Compose (app container): use service hostnames below (postgres, redis).
# Host-native Bun against published ports: see .env.host.example or `bun run dev:host`.

# --- Core ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bun_testing_test
# HiroApp uses its own database so it never replaces the fixture tables in DATABASE_URL.
APP_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/hiroapp_test
# Optional named MySQL connection for your own sidecar (not used by the generated examples)
# MYSQL_URL=mysql://strata:strata@mysql:3306/strata
PORT=3000
APP_ENV=local
APP_DEBUG=true
APP_NAME=HiroApp
APP_URL=http://localhost:3000
API_PREFIX=/api
APP_KEY_PREFIX=hiroapp

# api          JSON API only
# server-htmx  Eta templates + HTMX
# spa-react    SPA document + JSON API
# hybrid       HTML at / plus SPA at SPA_PREFIX
FRONTEND_MODE=server-htmx
SPA_PREFIX=/app

# --- Web sessions (server-htmx or hybrid) ---
# Required in production when FRONTEND_MODE=server-htmx or hybrid (32+ characters)
# HiroApp (cookie sessions) requires this; the compose app container runs APP_ENV=local.
SESSION_SECRET=dev-session-secret-change-me-please-32ch
# SESSION_COOKIE_NAME=hiroapp_session
# CSRF_COOKIE_NAME=hiroapp_csrf
# FLASH_COOKIE_NAME=hiroapp_flash
# MAIL_EHLO=hiroapp.local
# SIEM_EVENT_TYPE=hiroapp.audit
# APP_USER_AGENT=hiroapp
# SIGNED_URL_SECRET=change-me-in-production
# WEBHOOK_SIGNATURE_HEADER=x-hiroapp-signature
# JWT_SECRET=change-me-in-production
# JWT_TTL_SECONDS=3600

# --- Network / proxy ---
# TRUST_FORWARDED_FOR=true
# METRICS_TOKEN=

# --- Cache & queue ---
CACHE_DRIVER=redis
CACHE_TTL_MS=3600000
CACHE_MAX_ENTRIES=100
REDIS_URL=redis://:dev-redis-change-me@redis:6379
QUEUE_DRIVER=redis
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000

# --- Auth ---
# Tests only. Production must be false.
AUTH_DEV_HEADERS=false
ADMIN_API_TOKEN=strata-admin-test-token
MEMBER_API_TOKEN=strata-member-test-token

# --- Feature flags ---
FEATURE_WEBHOOKS=true
FEATURE_SEARCH=true
FEATURE_AUDIT_LOG=true
FEATURE_OAUTH=true
FEATURE_SAML=false
FEATURE_SCIM=true
FEATURE_BILLING=true
FEATURE_FIELD_ENCRYPTION=false
FEATURE_SIEM_EXPORT=true
FEATURE_PUBLIC_READS=true
FEATURE_EMAIL_VERIFICATION=false
FEATURE_MFA=false
FEATURE_REGISTRATION=true
FEATURE_ETAG=true
# FEATURE_OAUTH_MOCK=true

# --- API limits & CORS ---
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=120
# LOGIN_RATE_LIMIT_PER_WINDOW=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
MAX_REQUEST_BODY_BYTES=1048576
API_TOKEN_DEFAULT_EXPIRY_DAYS=
TOKEN_HASH_PEPPER=
OAUTH_STATE_SECRET=
SCIM_RATE_LIMIT_PER_MINUTE=60
STORAGE_PATH=storage

# --- Mail ---
# MAIL_DRIVER=log
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_FROM=

# --- Database pool ---
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30
DB_POOL_MAX_LIFETIME=3600
DB_CONNECTION_TIMEOUT=10
# DB_CONNECTION=pgsql

# --- OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/auth/oauth/github/callback
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# SAML_LOGIN_URL=

# --- SCIM ---
SCIM_BEARER_TOKEN=strata-scim-test-token

# --- Observability ---
# SCHEDULER_DRIVER=in-process-cron
# OTEL_SERVICE_NAME=hiroapp-api
# SIEM_EXPORT_URL=
# SIEM_EXPORT_TOKEN=
# SIEM_EXPORT_FORMAT=json

# --- Billing ---
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
