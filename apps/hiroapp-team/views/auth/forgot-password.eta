<section class="auth-card">
  <h1>Forgot password</h1>
  <% if (it.status) { %>
  <p class="ok"><%= it.status %></p>
  <% } %>
  <% if (it.errors && it.errors.form) { %>
  <p class="error"><%= it.errors.form %></p>
  <% } %>
  <form method="post" action="/forgot-password">
    <input type="hidden" name="_token" value="<%= it.csrfToken %>" />
    <label>
      Email
      <% if (it.errors && it.errors.email) { %><span class="error"><%= it.errors.email %></span><% } %>
      <input type="email" name="email" value="<%= it.email || "" %>" required />
    </label>
    <div class="actions">
      <button type="submit">Send reset link</button>
    </div>
  </form>
  <div class="auth-links">
    <a href="/login">Back to sign in</a>
  </div>
</section>
