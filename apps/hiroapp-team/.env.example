APP_NAME=hiroapp-team
APP_KEY_PREFIX=hiroapp-team
APP_ENV=local
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiroapp_team
# Optional. Migrate and boot against a different database than DATABASE_URL.
# APP_DATABASE_URL=
DB_CONNECTION=pgsql
FRONTEND_MODE=server-htmx
SPA_PREFIX=/app
TENANCY_DRIVER=none
CACHE_DRIVER=redis
QUEUE_DRIVER=redis
MAIL_DRIVER=log
AUTH_DEV_HEADERS=false
# Local convenience so the welcome page reads without a login.
# Production boot is blocked unless this is false.
FEATURE_PUBLIC_READS=true
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=dev-session-secret-change-me-please-32ch
# JWT_SECRET=
# FEATURE_API_TOKENS=false
FEATURE_MFA=false
FEATURE_EMAIL_VERIFICATION=false
METRICS_TOKEN=dev-metrics-token-change-me
# FEATURE_SCIM=false
# SCIM_BEARER_TOKEN=
# MAIL_HOST=
# MAIL_FROM=
# Behind a reverse proxy, trust X-Forwarded-For (rightmost public hop) for throttles and session IPs.
# TRUST_FORWARDED_FOR=true
