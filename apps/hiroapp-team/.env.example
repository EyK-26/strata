APP_NAME=hiroapp-team
APP_KEY_PREFIX=hiroapp-team
APP_ENV=local
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:dev-postgres-change-me@localhost:5432/hiroapp_team
# Optional. Migrate and boot against a different database than DATABASE_URL.
# APP_DATABASE_URL=
DB_CONNECTION=pgsql
FRONTEND_MODE=server-htmx
SPA_PREFIX=/app
TENANCY_DRIVER=none
CACHE_DRIVER=redis
QUEUE_DRIVER=redis
MAIL_DRIVER=log
AUTH_DEV_HEADERS=false
APP_DEBUG=false
FEATURE_PUBLIC_READS=false
FEATURE_SIEM_EXPORT=false
FEATURE_REGISTRATION=true
FEATURE_SAML=false
# SAML_IDP_SSO_URL=
# SAML_IDP_CERT=
# SAML_SP_ENTITY_ID=
# SAML_ACS_URL=
# SAML_IDP_ISSUER=
# SAML_WANT_RESPONSE_SIGNED=
# SAML_DISABLE_REQUESTED_AUTHN_CONTEXT=
REDIS_PASSWORD=dev-redis-change-me
REDIS_URL=redis://:dev-redis-change-me@127.0.0.1:6379
SESSION_SECRET=dev-session-secret-change-me-please-32ch
# JWT_SECRET=
# FEATURE_API_TOKENS=false
FEATURE_MFA=false
# KMS_ENCRYPTION_KEY=
FEATURE_EMAIL_VERIFICATION=false
METRICS_TOKEN=dev-metrics-token-change-me
# FEATURE_SCIM=false
# SCIM_BEARER_TOKEN=
# MAIL_HOST=
# MAIL_FROM=
# Behind a reverse proxy, trust X-Forwarded-For (rightmost public hop) for throttles and session IPs.
# TRUST_FORWARDED_FOR=true
