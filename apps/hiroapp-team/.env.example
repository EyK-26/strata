APP_NAME=hiroapp-team
APP_KEY_PREFIX=hiroapp-team
APP_ENV=local
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://strata_app:dev-strata-app-change-me@localhost:5432/hiroapp_team
# Runtime DATABASE_URL is strata_app (NOSUPERUSER NOBYPASSRLS).
# MIGRATION_DATABASE_URL is the postgres superuser for CREATE ROLE / CREATE DATABASE / GRANT / migrate.
# db/ensure-postgres-app-role.sql is repeatable on an existing volume, not only docker-entrypoint-initdb.d.
# This app is not TENANCY_DRIVER=rls; still do not point runtime traffic at the postgres superuser.
MIGRATION_DATABASE_URL=postgresql://postgres:dev-postgres-change-me@localhost:5432/hiroapp_team
# Optional. Point runtime at a different database than DATABASE_URL.
# APP_DATABASE_URL=
DB_CONNECTION=pgsql
FRONTEND_MODE=server-htmx
SPA_PREFIX=/app
TENANCY_DRIVER=none
CACHE_DRIVER=redis
QUEUE_DRIVER=redis
MAIL_DRIVER=log
AUTH_DEV_HEADERS=false
APP_DEBUG=false
FEATURE_PUBLIC_READS=false
# wrapWebPublicRead / wrapPublicRead require login when false (production-safe default).
# Local storefronts/catalogs may set true in .env. Production boot rejects FEATURE_PUBLIC_READS=true.
FEATURE_SIEM_EXPORT=false
# SIEM_EXPORT_URL=
# SIEM_EXPORT_TOKEN=
FEATURE_REGISTRATION=true
FEATURE_SAML=false
# SAML_IDP_SSO_URL=
# SAML_IDP_CERT=
# SAML_SP_ENTITY_ID=
# SAML_ACS_URL=
# SAML_IDP_ISSUER=
# SAML_WANT_RESPONSE_SIGNED=
# SAML_DISABLE_REQUESTED_AUTHN_CONTEXT=
FEATURE_OAUTH=false
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback
# OIDC_ALLOW_PRIVATE=true
# OAUTH_STATE_SECRET=
# --oidc (cookie HTML) seals PKCE in the oidc_pkce cookie. Do not call OidcProvider.getAuthorizationUrl().
FEATURE_BILLING=false
# STRIPE_WEBHOOK_SECRET=
# Outbound webhook deliveries (create-strata --webhooks). Local receivers:
# WEBHOOK_ALLOW_PRIVATE=true
# WEBHOOK_SIGNATURE_HEADER=
REDIS_PASSWORD=dev-redis-change-me
REDIS_URL=redis://:dev-redis-change-me@127.0.0.1:6379
SESSION_SECRET=dev-session-secret-change-me-please-32ch
# JWT_SECRET=
# FEATURE_API_TOKENS=false
FEATURE_MFA=false
# KMS_ENCRYPTION_KEY=
FEATURE_EMAIL_VERIFICATION=false
METRICS_TOKEN=dev-metrics-token-change-me
# FEATURE_SCIM=false
# SCIM_BEARER_TOKEN=
# MAIL_HOST=
# MAIL_FROM=
# Behind a reverse proxy, trust X-Forwarded-For (rightmost public hop) for throttles and session IPs.
# TRUST_FORWARDED_FOR=true
