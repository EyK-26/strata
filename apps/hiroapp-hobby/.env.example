APP_NAME=hiroapp-hobby
APP_KEY_PREFIX=hiroapp-hobby
APP_ENV=local
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=sqlite:./storage/app.sqlite
DB_CONNECTION=sqlite
FRONTEND_MODE=api
SPA_PREFIX=/app
TENANCY_DRIVER=none
CACHE_DRIVER=array
QUEUE_DRIVER=sync
MAIL_DRIVER=log
AUTH_DEV_HEADERS=true
APP_DEBUG=false
FEATURE_PUBLIC_READS=false
FEATURE_SIEM_EXPORT=false
FEATURE_REGISTRATION=true
FEATURE_SAML=false
# SAML_IDP_SSO_URL=
# SAML_IDP_CERT=
# SAML_SP_ENTITY_ID=
# SAML_ACS_URL=
# SAML_IDP_ISSUER=
# SAML_WANT_RESPONSE_SIGNED=false
# REDIS_PASSWORD=
# REDIS_URL=redis://127.0.0.1:6379
# SESSION_SECRET=
# JWT_SECRET=
# FEATURE_API_TOKENS=false
FEATURE_MFA=false
# KMS_ENCRYPTION_KEY=
FEATURE_EMAIL_VERIFICATION=false
# METRICS_TOKEN=
# FEATURE_SCIM=false
# SCIM_BEARER_TOKEN=
# MAIL_HOST=
# MAIL_FROM=
# Behind a reverse proxy, trust X-Forwarded-For (rightmost public hop) for throttles and session IPs.
# TRUST_FORWARDED_FOR=true
