APP_NAME=hiroapp
APP_KEY_PREFIX=hiroapp
APP_ENV=local
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiroapp_test
DB_CONNECTION=pgsql
FRONTEND_MODE=server-htmx
SPA_PREFIX=/app
TENANCY_DRIVER=rls
CACHE_DRIVER=redis
QUEUE_DRIVER=redis
MAIL_DRIVER=smtp
AUTH_DEV_HEADERS=false
FEATURE_PUBLIC_READS=true
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=dev-session-secret-change-me-please-32ch
JWT_SECRET=dev-jwt-secret-change-me-please-32chars
JWT_TTL_SECONDS=3600
FEATURE_API_TOKENS=true
TOKEN_HASH_PEPPER=dev-token-pepper-change-me
API_TOKEN_DEFAULT_EXPIRY_DAYS=30
FEATURE_MFA=true
FEATURE_EMAIL_VERIFICATION=true
METRICS_TOKEN=dev-metrics-token-change-me
FEATURE_SCIM=true
SCIM_BEARER_TOKEN=dev-scim-token-change-me
# SCIM_TENANT_TOKENS=1:token-a
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@hiroapp.local
MAIL_SECURE=false
# TRUST_FORWARDED_FOR=true
