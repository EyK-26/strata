APP_NAME=HiroApp
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_KEY_PREFIX=hiroapp
FRONTEND_MODE=server-htmx
# Use hybrid to keep staff HTML at / and serve the candidate SPA at SPA_PREFIX
SPA_PREFIX=/apply
TENANCY_DRIVER=rls
QUEUE_DRIVER=sync
MAIL_DRIVER=log
CACHE_DRIVER=array
AUTH_DEV_HEADERS=false
SESSION_SECRET=hiroapp-dev-session-secret-change-me
HIROAPP_SEED_SCALE=demo
SCIM_BEARER_TOKEN=hiroapp-scim-test-token
STRIPE_WEBHOOK_SECRET=whsec_hiroapp_test
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hiroapp
# Optional MySQL job-board mirror (Compose publishes 33061 on the host)
# MYSQL_URL=mysql://hiroapp:hiroapp@127.0.0.1:33061/hiroapp_job_board
# Optional on-site interview kiosk (file or :memory:)
# HIROAPP_KIOSK_SQLITE=/tmp/hiroapp-kiosk.sqlite
PORT=3000
