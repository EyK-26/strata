APP_NAME=hiroapp
APP_KEY_PREFIX=hiroapp
APP_ENV=local
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiroapp
# Optional. Migrate and boot against a different database than DATABASE_URL.
# APP_DATABASE_URL=
DB_CONNECTION=pgsql
FRONTEND_MODE=server-htmx
SPA_PREFIX=/app
TENANCY_DRIVER=rls
CACHE_DRIVER=redis
QUEUE_DRIVER=redis
MAIL_DRIVER=smtp
AUTH_DEV_HEADERS=false
APP_DEBUG=false
FEATURE_PUBLIC_READS=false
FEATURE_SIEM_EXPORT=false
FEATURE_REGISTRATION=true
FEATURE_SAML=false
# SAML_IDP_SSO_URL=
# SAML_IDP_CERT=
# SAML_SP_ENTITY_ID=
# SAML_ACS_URL=
# SAML_IDP_ISSUER=
# SAML_WANT_RESPONSE_SIGNED=false
REDIS_PASSWORD=dev-redis-change-me
REDIS_URL=redis://:dev-redis-change-me@127.0.0.1:6379
SESSION_SECRET=dev-session-secret-change-me-please-32ch
JWT_SECRET=dev-jwt-secret-change-me-please-32chars
JWT_TTL_SECONDS=3600
FEATURE_API_TOKENS=true
TOKEN_HASH_PEPPER=dev-token-pepper-change-me
API_TOKEN_DEFAULT_EXPIRY_DAYS=30
FEATURE_MFA=true
KMS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FEATURE_EMAIL_VERIFICATION=true
METRICS_TOKEN=dev-metrics-token-change-me
FEATURE_SCIM=true
SCIM_BEARER_TOKEN=dev-scim-token-change-me
# SCIM_TENANT_TOKENS=1:token-a
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@hiroapp.local
MAIL_SECURE=false
# Behind a reverse proxy, trust X-Forwarded-For (rightmost public hop) for throttles and session IPs.
# TRUST_FORWARDED_FOR=true
