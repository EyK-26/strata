<div class="Skills">
  <h2>Your skills</h2>
  <ul>
    <% it.owned.forEach((skill) => { %>
      <li><%= skill.name %> (<%= skill.level %>, <%= skill.years %> years)</li>
    <% }) %>
  </ul>
  <form action="/skills" method="post">
    <%~ include("../partials/csrf.eta") %>
    <label>
      Skill ids
      <input type="text" name="skill_ids" value="<%= it.owned.map((skill) => skill.id).join(',') %>" />
    </label>
    <p>Available: <% it.catalog.forEach((skill) => { %><span><%= skill.id %>=<%= skill.name %> </span><% }) %></p>
    <button type="submit">Save skills</button>
  </form>
</div>
