<div class="TalentPool">
  <h2>Talent pool</h2>
  <form class="TalentPoolForm" method="post" action="/talent-pool">
    <%~ include("../partials/csrf.eta") %>
    <label>Candidate user id <input name="user_id" /></label>
    <label>Notes <textarea name="notes"></textarea></label>
    <button type="submit">Keep candidate</button>
  </form>
  <% (it.entries ?? []).forEach((entry) => { %>
    <div class="list-item">
      <span><%= entry.user_id %> · <%= entry.status %> · <%= entry.notes %></span>
      <% if (entry.status === "active") { %>
        <form action="/talent-pool/<%= entry.id %>/reach-out" method="post">
          <%~ include("../partials/csrf.eta") %>
          <input type="hidden" name="return_to" value="/talent-pool" />
          <label>Subject <input name="subject" value="Talent pool outreach" /></label>
          <label>Message <textarea name="text" required></textarea></label>
          <button type="submit">Reach out</button>
        </form>
        <form action="/talent-pool/<%= entry.id %>/release" method="post">
          <%~ include("../partials/csrf.eta") %>
          <button type="submit">Release</button>
        </form>
      <% } %>
    </div>
  <% }) %>
</div>
