<div class="Inbox">
  <h2>Inbox</h2>
  <% if (!(it.notifications ?? []).length) { %>
    <p class="hint">Your inbox is empty.</p>
  <% } %>
  <% (it.notifications ?? []).forEach((msg) => { %>
    <div class="stack-row <%= msg.read_at ? 'message_read' : '' %>">
      <span>From: <%= msg.data?.from ?? "HiroApp" %></span>
      <span>Subject: <%= msg.data?.subject ?? msg.type ?? "Notification" %></span>
      <span><%= msg.read_at ? "Read" : "Unread" %></span>
      <% if (!msg.read_at) { %>
        <form action="/inbox/<%= msg.id %>/read" method="post">
          <%~ include("../partials/csrf.eta") %>
          <input type="hidden" name="return_to" value="/inbox" />
          <button type="submit">Mark as read</button>
        </form>
      <% } %>
    </div>
  <% }) %>
</div>
