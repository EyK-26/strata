<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HiroApp</title>
    <link rel="stylesheet" href="/assets/app.css" />
    <script src="/assets/htmx.min.js" defer></script>
  </head>
  <body class="site-shell">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="Header site-header">
      <a class="page_title brand" href="/">HiroApp</a>
      <input id="nav-toggle" class="peer nav-toggle" type="checkbox" />
      <label class="nav-toggle-label" for="nav-toggle">Menu</label>
      <%~ include("../partials/nav.eta") %>
      <% if (it.currentUser) { %>
        <span class="profile"><%= it.currentUser.first_name %> <%= it.currentUser.last_name %></span>
      <% } %>
    </header>
    <div class="main site-body">
      <%~ include("../partials/profile.eta") %>
      <div class="site-main" id="main-content">
        <% if (it.flash?.message) { %>
          <p class="flash hint"><%= it.flash.message %></p>
        <% } %>
        <div class="panel">
          <%~ it.body %>
        </div>
      </div>
    </div>
    <div class="footer">&copy; HiroApp <%= new Date().getFullYear() %></div>
  </body>
</html>
