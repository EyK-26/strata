<div class="Requisitions">
  <h2>Requisition queue</h2>
  <% if (!(it.requisitions ?? []).length) { %>
    <p class="hint">No submitted requisitions.</p>
  <% } %>
  <% (it.requisitions ?? []).forEach((requisition) => { %>
    <div class="stack-row">
      <span><%= requisition.position?.name ?? ("Seat " + requisition.position_id) %></span>
      <span><%= requisition.status %> · <%= requisition.notes %></span>
      <% if (it.currentUser?.role_id === 1 && requisition.status === "submitted") { %>
        <form action="/requisitions/<%= requisition.id %>/approve" method="post">
          <%~ include("../partials/csrf.eta") %>
          <input type="hidden" name="return_to" value="/requisitions" />
          <button type="submit">Approve</button>
        </form>
        <form action="/requisitions/<%= requisition.id %>/reject" method="post">
          <%~ include("../partials/csrf.eta") %>
          <input type="hidden" name="return_to" value="/requisitions" />
          <label>Notes <input name="notes" /></label>
          <button type="submit">Reject</button>
        </form>
      <% } %>
    </div>
  <% }) %>
</div>
