<div class="Page">
  <h1>Careers</h1>
  <% if (!(it.postings ?? []).length) { %>
    <p>No published jobs.</p>
  <% } %>
  <% (it.postings ?? []).forEach((posting) => { %>
    <p><% if (posting.pinned) { %><span>Pinned</span> <% } %><a href="/careers/<%= posting.id %>"><%= posting.name %></a></p>
  <% }) %>
</div>
