<div class="Dashboard">
  <h2>Dashboard</h2>
  <p>Applicants: <%= it.count %></p>
  <% it.applications.forEach((application) => { %>
    <a class="stack-row" href="/applications/<%= application.id %>">
      <span><%= application.user?.first_name %> <%= application.user?.last_name %></span>
      <span><%= application.position?.name %></span>
      <span><%= application.status?.name %></span>
    </a>
  <% }) %>
</div>
