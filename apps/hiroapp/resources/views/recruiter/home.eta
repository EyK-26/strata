<div class="HomeRecruiter">
  <div class="HomeRecruiter_links">
    <a href="/hirings">Your hirings</a>
    <a href="/dashboard">Dashboard</a>
    <a href="/applications">Pipeline</a>
    <a href="/position/create">Create a Position</a>
  </div>
  <div class="PipelineSummary">
    <h2>Hiring pipeline</h2>
    <p>Applied <%= it.summary?.applied ?? 0 %></p>
    <p>In progress <%= it.summary?.in_progress ?? 0 %></p>
    <p>Interview <%= it.summary?.interview ?? 0 %></p>
    <p>Feedback <%= it.summary?.feedback ?? 0 %></p>
    <p>Hired <%= it.summary?.hired ?? 0 %></p>
    <p>Ended <%= it.summary?.ended ?? 0 %></p>
    <p>Total <%= it.summary?.total ?? 0 %></p>
  </div>
  <%~ include("../applications/list.eta") %>
</div>
