<h1>Offer templates</h1>
<form class="OfferTemplateForm" method="post" action="/offer-templates">
  <%~ include("../partials/csrf.eta") %>
  <label>Name <input name="name" /></label>
  <label>Body <textarea name="body"></textarea></label>
  <label>Salary <input name="salary" type="number" min="1" /></label>
  <button type="submit">Save template</button>
</form>
<% (it.templates ?? []).forEach((template) => { %>
  <p><%= template.name %> · <%= template.salary %> · <%= template.body %></p>
  <form action="/offer-templates/<%= template.id %>/update" method="post">
    <%~ include("../partials/csrf.eta") %>
    <input type="hidden" name="name" value="<%= template.name %>" />
    <label>Body <textarea name="body"><%= template.body %></textarea></label>
    <button type="submit">Update</button>
  </form>
  <form action="/offer-templates/<%= template.id %>/delete" method="post">
    <%~ include("../partials/csrf.eta") %>
    <button type="submit">Delete</button>
  </form>
<% }) %>
