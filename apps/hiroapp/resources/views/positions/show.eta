<div class="PositionDetail">
  <h2><%= it.position.name %></h2>
  <p><%= it.position.description %></p>
  <p>Department: <%= it.position.department?.name %></p>
  <p>Grade: <%= it.position.grade?.name %></p>
  <% if (it.currentUser?.role_id !== 2 && it.position.hiring) { %>
    <form action="/positions/<%= it.position.id %>/close" method="post">
      <%~ include("../partials/csrf.eta") %>
      <button type="submit">Stop hiring</button>
    </form>
  <% } %>
  <% if (it.currentUser?.role_id !== 2 && !it.position.hiring && !it.position.user_id) { %>
    <form action="/positions/<%= it.position.id %>/reopen" method="post">
      <%~ include("../partials/csrf.eta") %>
      <button type="submit">Reopen hiring</button>
    </form>
  <% } %>
  <% if (it.currentUser?.role_id === 1) { %>
    <form action="/positions/<%= it.position.id %>/delete" method="post">
      <%~ include("../partials/csrf.eta") %>
      <button type="submit">Delete position</button>
    </form>
  <% } %>
  <% if (it.currentUser?.role_id !== 2) { %>
    <p><a href="/positions/<%= it.position.id %>/skills">Skills and match</a></p>
    <% if (it.position.department_id) { %>
      <p><a href="/departments/<%= it.position.department_id %>/applications">Department applications</a></p>
    <% } %>
    <form action="/positions/<%= it.position.id %>/interviewers" method="post">
      <%~ include("../partials/csrf.eta") %>
      <label>Interviewer user ids <input type="text" name="user_ids" placeholder="3,1" /></label>
      <button type="submit">Assign interviewers</button>
    </form>
  <% } %>
  <form action="/positions/<%= it.position.id %>/watch" method="post">
    <%~ include("../partials/csrf.eta") %>
    <button type="submit">Toggle watch</button>
  </form>
  <h3>Applicants</h3>
  <% it.applications.forEach((application) => { %>
    <a class="list-item" href="/applications/<%= application.id %>">
      <span><%= application.user?.first_name %> <%= application.user?.last_name %></span>
      <span><%= application.status?.name %></span>
    </a>
  <% }) %>
  <div class="comments">
    <h3>Comments</h3>
    <% (it.comments ?? []).forEach((comment) => { %>
      <p><%= comment.body %></p>
    <% }) %>
    <form action="/positions/<%= it.position.id %>/comments" method="post">
      <%~ include("../partials/csrf.eta") %>
      <label>Add comment <textarea name="body"></textarea></label>
      <button type="submit">Save comment</button>
    </form>
  </div>
</div>
