<div class="OpenPositions">
  <h2>Open Positions</h2>
  <% if (it.can_restore) { %>
    <p><a href="/positions/deleted">Deleted positions</a></p>
  <% } %>
  <% (it.positions ?? []).forEach((position) => { %>
    <div>
      <a class="stack-row" href="/positions/<%= position.id %>">
        <span><%= position.name %></span>
        <span>(<%= (position.applications ?? []).length %>)</span>
      </a>
      <span>Due:<%= position.start_date ? position.start_date : "Not determined" %></span>
    </div>
  <% }) %>
</div>
