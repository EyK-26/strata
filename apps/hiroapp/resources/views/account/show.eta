<section class="page-header">
  <h1>Account</h1>
  <p class="hint">Update your HiroApp profile and password. Staff accounts can manage MFA, browser sessions, and personal access tokens.</p>
</section>

<% if (it.errors && Object.keys(it.errors).length > 0) { %>
<div class="form-errors" role="alert">
  <% for (const [field, message] of Object.entries(it.errors)) { %>
    <p><strong><%= field %></strong>: <%= message %></p>
  <% } %>
</div>
<% } %>

<section class="card" id="profile">
  <h2>Profile</h2>
  <form method="post" action="/account/profile" class="stack-form">
    <%~ include("../partials/csrf.eta") %>
    <label>
      First name
      <input type="text" name="first_name" value="<%= it.user.first_name %>" required />
    </label>
    <label>
      Last name
      <input type="text" name="last_name" value="<%= it.user.last_name %>" required />
    </label>
    <label>
      Email
      <input type="email" name="email" value="<%= it.user.email %>" required />
    </label>
    <button type="submit">Update profile</button>
  </form>
</section>

<% if (it.staff) { %>
<section class="card" id="team">
  <h2>Hiring team</h2>
  <% if (!it.memberships?.length) { %>
    <p class="hint">You are not on a hiring team yet.</p>
  <% } else { %>
    <ul>
      <% for (const membership of it.memberships) { %>
        <li>
          <%= membership.name %> (<%= membership.role %>)
          <% if (membership.current) { %><strong>Current</strong><% } %>
          <% if (!membership.current) { %>
            <form method="post" action="/account/current-department">
              <%~ include("../partials/csrf.eta") %>
              <input type="hidden" name="department_id" value="<%= membership.department_id %>" />
              <button type="submit">Switch</button>
            </form>
          <% } %>
        </li>
      <% } %>
    </ul>
  <% } %>
  <h3>Invitations</h3>
  <% if (!it.invitations?.length) { %>
    <p class="hint">No pending hiring-team invitations.</p>
  <% } else { %>
    <ul>
      <% for (const invitation of it.invitations) { %>
        <li>
          <%= invitation.department?.name ?? invitation.department_id %> as <%= invitation.role %>
          <form method="post" action="/account/invitations/<%= invitation.id %>/accept">
            <%~ include("../partials/csrf.eta") %>
            <button type="submit">Accept</button>
          </form>
          <form method="post" action="/account/invitations/<%= invitation.id %>/decline">
            <%~ include("../partials/csrf.eta") %>
            <button type="submit">Decline</button>
          </form>
        </li>
      <% } %>
    </ul>
  <% } %>
</section>
<% } %>

<section class="card" id="password">
  <h2>Password</h2>
  <form method="post" action="/account/password" class="stack-form">
    <%~ include("../partials/csrf.eta") %>
    <label>
      Current password
      <input type="password" name="current_password" required autocomplete="current-password" />
    </label>
    <label>
      New password
      <input type="password" name="password" required autocomplete="new-password" />
    </label>
    <label>
      Confirm password
      <input type="password" name="password_confirmation" required autocomplete="new-password" />
    </label>
    <button type="submit">Update password</button>
  </form>
</section>

<% if (it.staff) { %>
<section class="card" id="mfa">
  <h2>Two-factor authentication</h2>
  <% if (it.mfaEnabled) { %>
    <p>Authenticator app is enabled.</p>
    <% if (it.recoveryCodes) { %>
      <p>Store these recovery codes:</p>
      <ul>
        <% for (const code of it.recoveryCodes) { %>
          <li><code><%= code %></code></li>
        <% } %>
      </ul>
    <% } %>
    <form method="post" action="/account/mfa/disable" class="stack-form">
      <%~ include("../partials/csrf.eta") %>
      <label>
        Password
        <input type="password" name="password" required autocomplete="current-password" />
      </label>
      <button type="submit">Disable MFA</button>
    </form>
  <% } else { %>
    <% if (it.mfaSecret) { %>
      <p>Scan this QR code or enter the secret, then confirm a code.</p>
      <% if (it.mfaQr) { %>
        <p><img src="<%= it.mfaQr %>" alt="MFA QR code" width="160" height="160" /></p>
      <% } %>
      <p><code><%= it.mfaSecret %></code></p>
      <form method="post" action="/account/mfa/confirm" class="stack-form">
        <%~ include("../partials/csrf.eta") %>
        <label>
          Authenticator code
          <input type="text" name="mfa_code" required autocomplete="one-time-code" />
        </label>
        <button type="submit">Confirm MFA</button>
      </form>
    <% } else { %>
      <form method="post" action="/account/mfa">
        <%~ include("../partials/csrf.eta") %>
        <button type="submit">Enable MFA</button>
      </form>
    <% } %>
  <% } %>
</section>

<section class="card" id="sessions">
  <h2>Browser sessions</h2>
  <ul>
    <% for (const session of it.sessions ?? []) { %>
      <li>
        <%= session.user_agent %> <%= session.ip_address %>
        <% if (session.current) { %><strong>This device</strong><% } %>
        <% if (!session.current) { %>
          <form method="post" action="/account/sessions/<%= session.id %>/logout">
            <%~ include("../partials/csrf.eta") %>
            <button type="submit">Log out</button>
          </form>
        <% } %>
      </li>
    <% } %>
  </ul>
  <form method="post" action="/account/logout-other-devices" class="stack-form">
    <%~ include("../partials/csrf.eta") %>
    <label>
      Password
      <input type="password" name="password" required autocomplete="current-password" />
    </label>
    <button type="submit">Log out other devices</button>
  </form>
</section>

<section class="card" id="tokens">
  <h2>API tokens</h2>
  <% if (it.plainTextToken) { %>
    <p>Copy this token now. It will not be shown again: <code><%= it.plainTextToken %></code></p>
  <% } %>
  <ul>
    <% for (const token of it.tokens ?? []) { %>
      <li>
        <%= token.name %>
        <form method="post" action="/account/tokens/<%= token.id %>/revoke">
          <%~ include("../partials/csrf.eta") %>
          <button type="submit">Revoke</button>
        </form>
      </li>
    <% } %>
  </ul>
  <form method="post" action="/account/tokens" class="stack-form">
    <%~ include("../partials/csrf.eta") %>
    <label>
      Token name
      <input type="text" name="name" required />
    </label>
    <button type="submit">Create token</button>
  </form>
</section>
<% } %>
