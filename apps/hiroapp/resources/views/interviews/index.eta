<div class="Interviews">
  <h2>Interviews</h2>
  <% (it.interviews ?? []).forEach((interview) => { %>
    <div class="list-item">
      <span><%= interview.scheduled_at %></span>
      <span><%= interview.place %></span>
      <span><%= interview.status %></span>
      <% if (it.currentUser?.role_id === 2 && interview.status === "scheduled") { %>
        <form action="/interviews/<%= interview.id %>/confirm" method="post">
          <%~ include("../partials/csrf.eta") %>
          <button>Confirm</button>
        </form>
      <% } %>
      <% if (it.currentUser?.role_id !== 2) { %>
        <form action="/interviews/<%= interview.id %>/scorecards" method="post">
          <%~ include("../partials/csrf.eta") %>
          <label>Score <input type="number" name="overall_score" min="1" max="5" /></label>
          <label>Recommendation
            <select name="recommendation">
              <option value="hire">Hire</option>
              <option value="hold">Hold</option>
              <option value="no_hire">No hire</option>
            </select>
          </label>
          <label>Notes <textarea name="notes"></textarea></label>
          <button>Save scorecard</button>
        </form>
      <% } %>
    </div>
  <% }) %>
</div>
