<div class="Referrals">
  <h2>My referrals</h2>
  <% if (!(it.referrals ?? []).length) { %>
    <p class="hint">You have not referred anyone yet.</p>
  <% } %>
  <% (it.referrals ?? []).forEach((referral) => { %>
    <div class="stack-row">
      <span><%= referral.name %> · <%= referral.email %></span>
      <span>Seat <%= referral.position_id %> · <%= referral.status %></span>
      <% if (referral.status !== "closed") { %>
        <form action="/referrals/<%= referral.id %>/close" method="post">
          <%~ include("../partials/csrf.eta") %>
          <input type="hidden" name="return_to" value="/referrals" />
          <button type="submit">Close referral</button>
        </form>
      <% } %>
    </div>
  <% }) %>
</div>
