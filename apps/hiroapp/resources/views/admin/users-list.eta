<div class="Users">
  <h2>Users</h2>
  <% (it.users ?? []).forEach((user) => { %>
    <a class="stack-row" href="/users/<%= user.id %>">
      <span><%= user.last_name %>, <%= user.first_name %></span>
      <span><%= user.position?.name ?? "" %></span>
      <span><%= user.position?.department?.name ?? "" %></span>
    </a>
  <% }) %>
</div>
