<% if (it.currentUser) { %>
  <aside class="UserProfile">
    <span class="username"><%= it.currentUser.first_name %> <%= it.currentUser.last_name %></span>
    <span class="department"><%= it.currentUser.position?.department?.name ?? "" %></span>
    <% const notes = it.notifications ?? it.currentUser.notifications ?? [] %>
    <% const unread = notes.filter((n) => !n.read_at) %>
    <% if (notes.length > 0) { %>
      <div class="inbox">
        <div class="logo_with_number">Inbox: <%= unread.length %></div>
        <% notes.slice(0, 5).forEach((msg) => { %>
          <div class="<%= msg.read_at ? 'notification_preview message_read' : 'notification_preview' %>">
            <span>From: <%= msg.data?.from ?? "HiroApp" %></span>
            <span>Subject: <%= msg.data?.subject ?? msg.type ?? "Notification" %></span>
          </div>
        <% }) %>
        <% if (notes.length > 5) { %>
          <details>
            <summary>Show <%= notes.length - 5 %> more</summary>
            <% notes.slice(5).forEach((msg) => { %>
              <div class="<%= msg.read_at ? 'notification_preview message_read' : 'notification_preview' %>">
                <span>From: <%= msg.data?.from ?? "HiroApp" %></span>
                <span>Subject: <%= msg.data?.subject ?? msg.type ?? "Notification" %></span>
              </div>
            <% }) %>
          </details>
        <% } %>
      </div>
    <% } else { %>
      Your Inbox is Empty
    <% } %>
    <form action="/logout" method="post">
      <%~ include("./csrf.eta") %>
      <button type="submit">Logout</button>
    </form>
  </aside>
<% } %>
