<div class="Page">
  <h1>Candidate tags</h1>
  <form class="TagForm" method="post" action="/tags">
    <%~ include("../partials/csrf.eta") %>
    <p>
      <label for="tag-user">Candidate user id
        <input id="tag-user" name="user_id" />
      </label>
    </p>
    <p>
      <label for="tag-label">Label
        <input id="tag-label" name="label" />
      </label>
    </p>
    <button type="submit">Add tag</button>
  </form>
  <% (it.tags ?? []).forEach((tag) => { %>
    <p><%= tag.user_id %> · <%= tag.label %></p>
    <form action="/tags/<%= tag.id %>/delete" method="post">
      <%~ include("../partials/csrf.eta") %>
      <input type="hidden" name="return_to" value="/tags" />
      <button type="submit">Remove</button>
    </form>
  <% }) %>
</div>
