<div class="ApplicationDetail">
  <% const roleId = Number(it.currentUser?.role_id ?? it.roleId) %>
  <div class="ApplicationDetailHeader">
    <h2><%= it.application.user?.first_name %> <%= it.application.user?.last_name %></h2>
  </div>
  <div class="body">
    <div class="ApplicationDetailDetails">
      <p><%= it.application.position?.name ?? "" %></p>
      <p><%= it.application.position?.department?.name ?? "" %></p>
      <p><%= it.application.attachment_text ?? "" %></p>
      <% if (it.application.attachment_file) { %>
        <p><a href="<%= it.application.attachment_file %>"><%= it.application.attachment_file %></a></p>
      <% } %>
    </div>
    <div class="ApplicationDetailStatus">
      <div class="topPart">
        <% if (it.application.status_id < 5) { %>
          <form action="/applications/<%= it.application.id %>/end" method="post">
            <%~ include("../partials/csrf.eta") %>
            <button type="submit"><%= roleId === 2 ? "Retrieve Your Application" : "Reject" %></button>
          </form>
        <% } %>
      </div>
      <div class="<%= roleId !== 2 ? 'progress hasButton' : 'progress' %>">
        <% it.all_statuses.forEach((status) => { %>
          <% let className = "status" %>
          <% if (status.id === 6) { className += " ended" } %>
          <% if (status.id < it.application.status_id) { className += " status-done" } else if (status.id === it.application.status_id) { className += " status-active" } else { className += " status-future" } %>
          <div class="<%= className %>">
            <div class="circle"></div>
            <span><%= status.name %></span>
            <% if (roleId !== 2 && status.id === it.application.status_id && it.application.status_id < 4) { %>
              <form action="/applications/<%= it.application.id %>/move" method="post">
                <%~ include("../partials/csrf.eta") %>
                <button type="submit">Move To Next Stage</button>
              </form>
            <% } %>
            <% if (roleId !== 2 && status.id === it.application.status_id && it.application.status_id === 4) { %>
              <form action="/applications/<%= it.application.id %>/move" method="post">
                <%~ include("../partials/csrf.eta") %>
                <button type="submit">Hire</button>
              </form>
            <% } %>
          </div>
        <% }) %>
      </div>
      <% if (roleId !== 2 && it.application.status_id < 5 && (it.transfer_seats ?? []).length) { %>
        <form class="TransferForm" action="/applications/<%= it.application.id %>/transfer" method="post">
          <%~ include("../partials/csrf.eta") %>
          <label>Hiring seat
            <select name="position_id" required>
              <% (it.transfer_seats ?? []).forEach((seat) => { %>
                <option value="<%= seat.id %>"><%= seat.name %></option>
              <% }) %>
            </select>
          </label>
          <button type="submit">Transfer application</button>
        </form>
      <% } %>
      <% if (roleId === 2 && it.application.status_id < 5) { %>
        <form action="/applications/<%= it.application.id %>/withdraw" method="post">
          <%~ include("../partials/csrf.eta") %>
          <button type="submit">Withdraw application</button>
        </form>
      <% } %>
      <% if (roleId !== 2 && it.application.status_id === 2) { %>
        <form class="InterviewScheduleForm" action="/interviews" method="post">
          <%~ include("../partials/csrf.eta") %>
          <input type="hidden" name="application_id" value="<%= it.application.id %>" />
          <input type="hidden" name="applicant_id" value="<%= it.application.user_id %>" />
          <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
          <label>Message <textarea name="text"></textarea></label>
          <label>When <input type="datetime-local" name="datetime" /></label>
          <label>Where <input type="text" name="place" /></label>
          <button>Schedule interview</button>
        </form>
      <% } %>
      <% if ((it.interviews ?? []).length) { %>
        <h3>Interviews</h3>
        <% it.interviews.forEach((interview) => { %>
          <p><%= interview.scheduled_at %> · <%= interview.place %> · <%= interview.status %></p>
          <% if ((interview.scorecards ?? []).length) { %>
            <p>Scorecards: <%= interview.scorecard_summary?.count %> · avg <%= interview.scorecard_summary?.average %></p>
            <% interview.scorecards.forEach((card) => { %>
              <p><%= card.overall_score %> · <%= card.recommendation %> · <%= card.notes %></p>
            <% }) %>
          <% } %>
          <% if (it.currentUser?.role_id === 2 && interview.status === "scheduled") { %>
            <form action="/interviews/<%= interview.id %>/confirm" method="post">
              <%~ include("../partials/csrf.eta") %>
              <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
              <button type="submit">Confirm interview</button>
            </form>
          <% } %>
          <% if (it.currentUser?.role_id === 2 && (interview.status === "scheduled" || interview.status === "confirmed")) { %>
            <form action="/interviews/<%= interview.id %>/decline" method="post">
              <%~ include("../partials/csrf.eta") %>
              <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
              <button type="submit">Decline interview</button>
            </form>
          <% } %>
          <% if (roleId !== 2) { %>
            <form class="ScorecardForm" action="/interviews/<%= interview.id %>/scorecards" method="post">
              <%~ include("../partials/csrf.eta") %>
              <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
              <label>Score <input type="number" name="overall_score" min="1" max="5" /></label>
              <label>Recommendation
                <select name="recommendation">
                  <option value="hire">Hire</option>
                  <option value="hold">Hold</option>
                  <option value="no_hire">No hire</option>
                </select>
              </label>
              <label>Notes <textarea name="notes"></textarea></label>
              <button type="submit">Save scorecard</button>
            </form>
          <% } %>
          <% if (roleId !== 2 && (interview.status === "scheduled" || interview.status === "confirmed")) { %>
            <form action="/interviews/<%= interview.id %>/complete" method="post">
              <%~ include("../partials/csrf.eta") %>
              <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
              <label>Notes <textarea name="notes"></textarea></label>
              <button type="submit">Complete interview</button>
            </form>
            <form action="/interviews/<%= interview.id %>/cancel" method="post">
              <%~ include("../partials/csrf.eta") %>
              <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
              <button type="submit">Cancel interview</button>
            </form>
            <form action="/interviews/<%= interview.id %>/no-show" method="post">
              <%~ include("../partials/csrf.eta") %>
              <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
              <button type="submit">Mark no-show</button>
            </form>
          <% } %>
        <% }) %>
      <% } %>
      <% if ((it.offers ?? []).length) { %>
        <h3>Offers</h3>
        <% it.offers.forEach((offer) => { %>
          <p><%= offer.salary %> · <%= offer.starts_on %> · <%= offer.status %><% if (offer.expires_at) { %> · expires <%= offer.expires_at %><% } %></p>
          <% if (roleId !== 2 && (offer.status === "draft" || offer.status === "sent")) { %>
            <% if (offer.status === "draft") { %>
              <form action="/offers/<%= offer.id %>/send" method="post">
                <%~ include("../partials/csrf.eta") %>
                <label>Expires <input type="datetime-local" name="expires_at" /></label>
                <button type="submit">Send offer</button>
              </form>
            <% } %>
            <% if (offer.status === "sent") { %>
              <form action="/offers/<%= offer.id %>/expire" method="post">
                <%~ include("../partials/csrf.eta") %>
                <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
                <button type="submit">Expire offer</button>
              </form>
            <% } %>
            <form action="/offers/<%= offer.id %>/withdraw" method="post">
              <%~ include("../partials/csrf.eta") %>
              <button type="submit">Withdraw offer</button>
            </form>
          <% } %>
          <% if (roleId === 2 && offer.status === "sent") { %>
            <form action="/offers/<%= offer.id %>/accept" method="post">
              <%~ include("../partials/csrf.eta") %>
              <button type="submit">Accept offer</button>
            </form>
            <form action="/offers/<%= offer.id %>/decline" method="post">
              <%~ include("../partials/csrf.eta") %>
              <button type="submit">Decline offer</button>
            </form>
          <% } %>
        <% }) %>
      <% } %>
      <% if (roleId !== 2 && it.application.status_id >= 4 && it.application.status_id < 6) { %>
        <form class="OfferForm" action="/applications/<%= it.application.id %>/offers" method="post">
          <%~ include("../partials/csrf.eta") %>
          <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
          <label>Template
            <select name="template_id">
              <option value="">None</option>
              <% (it.offer_templates ?? []).forEach((template) => { %>
                <option value="<%= template.id %>"><%= template.name %></option>
              <% }) %>
            </select>
          </label>
          <label>Salary <input type="number" name="salary" min="1" /></label>
          <label>Starts <input type="date" name="starts_on" /></label>
          <label>Notes <textarea name="notes"></textarea></label>
          <button type="submit">Save draft offer</button>
        </form>
      <% } %>
      <% if ((it.rejections ?? []).length) { %>
        <h3>Rejection reasons</h3>
        <% it.rejections.forEach((rejection) => { %>
          <p><%= rejection.reason_name %> · <%= rejection.notes %></p>
        <% }) %>
      <% } %>
      <% if (it.source) { %>
        <p>Source: <%= it.source.source_name %></p>
      <% } %>
      <% if (roleId !== 2) { %>
        <form class="SourceForm" action="/applications/<%= it.application.id %>/source" method="post">
          <%~ include("../partials/csrf.eta") %>
          <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
          <label>Source
            <select name="source_id">
              <% (it.application_sources ?? []).forEach((source) => { %>
                <option value="<%= source.id %>"><%= source.name %></option>
              <% }) %>
            </select>
          </label>
          <label>Notes <textarea name="notes"></textarea></label>
          <button type="submit">Save source</button>
        </form>
      <% } %>
      <% if (it.hold && it.hold.status === "holding") { %>
        <h3>Hold</h3>
        <p><%= it.hold.status %> · <%= it.hold.notes %><% if (it.hold.holds_until) { %> · until <%= it.hold.holds_until %><% } %></p>
        <% if (roleId !== 2) { %>
          <form action="/holds/<%= it.hold.id %>/release" method="post">
            <%~ include("../partials/csrf.eta") %>
            <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
            <button type="submit">Release hold</button>
          </form>
        <% } %>
      <% } %>
      <% if (roleId !== 2 && (!it.hold || it.hold.status === "released")) { %>
        <form class="HoldForm" action="/applications/<%= it.application.id %>/hold" method="post">
          <%~ include("../partials/csrf.eta") %>
          <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
          <label>Hold notes <textarea name="notes"></textarea></label>
          <label>Hold until <input type="datetime-local" name="holds_until" /></label>
          <button type="submit">Put on hold</button>
        </form>
      <% } %>
      <% if (it.background_check) { %>
        <h3>Background check</h3>
        <p><%= it.background_check.vendor %> · <%= it.background_check.status %> · <%= it.background_check.notes %></p>
        <% if (roleId !== 2 && it.background_check.status === "requested") { %>
          <form action="/background-checks/<%= it.background_check.id %>/clear" method="post">
            <%~ include("../partials/csrf.eta") %>
            <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
            <button type="submit">Mark clear</button>
          </form>
          <form action="/background-checks/<%= it.background_check.id %>/flag" method="post">
            <%~ include("../partials/csrf.eta") %>
            <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
            <button type="submit">Mark flagged</button>
          </form>
          <form action="/background-checks/<%= it.background_check.id %>/cancel" method="post">
            <%~ include("../partials/csrf.eta") %>
            <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
            <button type="submit">Cancel check</button>
          </form>
        <% } %>
      <% } %>
      <% if (roleId !== 2 && (!it.background_check || it.background_check.status === "cancelled")) { %>
        <form class="BackgroundCheckForm" action="/applications/<%= it.application.id %>/background-check" method="post">
          <%~ include("../partials/csrf.eta") %>
          <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
          <label>Vendor <input name="vendor" /></label>
          <label>Notes <textarea name="notes"></textarea></label>
          <button type="submit">Request background check</button>
        </form>
      <% } %>
      <% if (roleId !== 2 && it.talent_pool && it.talent_pool.status === "active") { %>
        <p>In talent pool</p>
        <form action="/talent-pool/<%= it.talent_pool.id %>/release" method="post">
          <%~ include("../partials/csrf.eta") %>
          <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
          <button type="submit">Release from talent pool</button>
        </form>
      <% } %>
      <% if (roleId !== 2 && (!it.talent_pool || it.talent_pool.status !== "active")) { %>
        <form class="TalentPoolForm" action="/applications/<%= it.application.id %>/talent-pool" method="post">
          <%~ include("../partials/csrf.eta") %>
          <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
          <label>Notes <textarea name="notes"></textarea></label>
          <button type="submit">Keep in talent pool</button>
        </form>
      <% } %>
      <% if ((it.onboarding ?? []).length) { %>
        <h3>Onboarding</h3>
        <% it.onboarding.forEach((item) => { %>
          <p><%= item.title %> · <%= item.status %> · <%= item.notes %></p>
          <% if (item.status === "open") { %>
            <form action="/onboarding/<%= item.id %>/complete" method="post">
              <%~ include("../partials/csrf.eta") %>
              <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
              <button type="submit">Mark done</button>
            </form>
          <% } %>
        <% }) %>
      <% } %>
      <% if (roleId !== 2 && it.application.status_id === 5) { %>
        <form class="OnboardingForm" action="/applications/<%= it.application.id %>/onboarding" method="post">
          <%~ include("../partials/csrf.eta") %>
          <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
          <label>Title <input name="title" /></label>
          <label>Notes <textarea name="notes"></textarea></label>
          <button type="submit">Add onboarding item</button>
        </form>
      <% } %>
      <% if (roleId !== 2 && it.application.status_id < 6) { %>
        <form class="RejectForm" action="/applications/<%= it.application.id %>/reject" method="post">
          <%~ include("../partials/csrf.eta") %>
          <input type="hidden" name="return_to" value="/applications/<%= it.application.id %>" />
          <label>Reason
            <select name="reason_id">
              <% (it.rejection_reasons ?? []).forEach((reason) => { %>
                <option value="<%= reason.id %>"><%= reason.name %></option>
              <% }) %>
            </select>
          </label>
          <label>Notes <textarea name="notes"></textarea></label>
          <button type="submit">Reject with reason</button>
        </form>
      <% } %>
    </div>
  </div>
  <div class="comments">
    <h3>Comments</h3>
    <% (it.comments ?? []).forEach((comment) => { %>
      <p><%= comment.author ? (comment.author.first_name + " " + comment.author.last_name) : "Staff" %> · <%= comment.body %></p>
    <% }) %>
    <form action="/applications/<%= it.application.id %>/comments" method="post">
      <%~ include("../partials/csrf.eta") %>
      <label>Add comment <textarea name="body"></textarea></label>
      <button type="submit">Save comment</button>
    </form>
  </div>
</div>
