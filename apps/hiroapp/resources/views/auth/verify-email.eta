<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Confirm your email | HiroApp</title>
    <link rel="stylesheet" href="/assets/app.css" />
  </head>
  <body>
    <div class="container">
      <div class="auth-card">
        <h1>Confirm your email</h1>
        <p>We sent a confirmation link to <strong><%= it.email %></strong>. Open that link to continue using HiroApp.</p>
        <form action="/email/verification-notification" method="post">
          <%~ include("../partials/csrf.eta") %>
          <button>Send another email</button>
        </form>
      </div>
    </div>
  </body>
</html>
