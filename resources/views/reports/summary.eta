<section class="page-header">
  <h1>Reports</h1>
  <p class="hint">Tenant-wide counts. Signed-in HTML <code>/reports</code> redirects to the current team; this page is <code>?all=1</code>. The JSON twin is GET /api/v1/reports/summary.</p>
</section>

<dl class="detail-list">
  <div>
    <dt>Organizations</dt>
    <dd><%= it.summary.organization_count %></dd>
  </div>
  <div>
    <dt>Projects</dt>
    <dd><%= it.summary.project_count %></dd>
  </div>
  <div>
    <dt>Tasks</dt>
    <dd><%= it.summary.task_count %></dd>
  </div>
  <div>
    <dt>Comments</dt>
    <dd><%= it.summary.comment_count %></dd>
  </div>
</dl>

<section class="card">
  <h2>Projects by status</h2>
  <ul>
    <% for (const [status, count] of Object.entries(it.summary.projects_by_status ?? {})) { %>
    <li><%= status %>: <%= count %></li>
    <% } %>
  </ul>
</section>

<section class="card">
  <h2>Tasks by status</h2>
  <ul>
    <% for (const [status, count] of Object.entries(it.summary.tasks_by_status ?? {})) { %>
    <li><%= status %>: <%= count %></li>
    <% } %>
  </ul>
</section>

<p class="hint">
  <% if (it.currentOrganizationId) { %>
  <a href="/reports/organizations/<%= it.currentOrganizationId %>">Current team report</a>
  ·
  <% } %>
  Open any organization report at
  <code>/reports/organizations/:id</code>.
</p>
