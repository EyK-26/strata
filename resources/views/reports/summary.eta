<section class="page-header">
  <h1>Reports</h1>
  <p class="hint">Cross-module counts for the current tenant. The JSON twin is GET /api/v1/reports/summary.</p>
</section>

<dl class="detail-list">
  <div>
    <dt>Organizations</dt>
    <dd><%= it.summary.organization_count %></dd>
  </div>
  <div>
    <dt>Projects</dt>
    <dd><%= it.summary.project_count %></dd>
  </div>
  <div>
    <dt>Tasks</dt>
    <dd><%= it.summary.task_count %></dd>
  </div>
  <div>
    <dt>Comments</dt>
    <dd><%= it.summary.comment_count %></dd>
  </div>
</dl>

<section class="card">
  <h2>Projects by status</h2>
  <ul>
    <% for (const [status, count] of Object.entries(it.summary.projects_by_status ?? {})) { %>
    <li><%= status %>: <%= count %></li>
    <% } %>
  </ul>
</section>

<section class="card">
  <h2>Tasks by status</h2>
  <ul>
    <% for (const [status, count] of Object.entries(it.summary.tasks_by_status ?? {})) { %>
    <li><%= status %>: <%= count %></li>
    <% } %>
  </ul>
</section>

<p class="hint">
  Open an organization report at
  <a href="/reports/organizations/1">/reports/organizations/1</a>
  (Acme Labs in the seed).
</p>
