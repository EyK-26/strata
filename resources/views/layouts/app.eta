<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= it.title ?? "WorkHub" %></title>
    <meta name="csrf-token" content="<%= it.csrfToken ?? "" %>" />
    <meta name="htmx-config" content='{"inlineStyleNonce":"<%= it.cspNonce ?? "" %>"}' />
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script nonce="<%= it.cspNonce ?? "" %>">
      document.addEventListener("htmx:configRequest", (event) => {
        const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute("content");
        if (token) {
          event.detail.headers["X-CSRF-Token"] = token;
        }
      });
    </script>
    <link rel="stylesheet" href="/assets/app.css" />
  </head>
  <body>
    <header class="site-header">
      <a href="/organizations" class="brand">WorkHub</a>
      <nav>
        <a href="/organizations">Organizations</a>
        <a href="/projects">Projects</a>
        <a href="/tasks">Tasks</a>
        <a href="/search">Search</a>
        <a href="/reports">Reports</a>
        <a href="/billing">Billing</a>
        <a href="/webhooks">Webhooks</a>
        <a href="/admin">Admin</a>
        <% if (it.authUser) { %>
        <div
          id="notifications-bell"
          class="notifications-bell"
          hx-get="/notifications"
          hx-trigger="load, every 30s"
          hx-swap="innerHTML"
        ></div>
        <a href="/account" class="nav-user"><%= it.authUser.email %></a>
        <form method="post" action="/logout" class="nav-logout">
          <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
          <button type="submit">Sign out</button>
        </form>
        <% } else { %>
        <a href="/login">Sign in</a>
        <% } %>
        <a href="/api/v1/reports/summary">API summary</a>
      </nav>
    </header>
    <main class="site-main">
      <% if (it.flash) { %>
      <div class="flash flash-<%= it.flash.level %>" role="status"><%= it.flash.message %></div>
      <% } %>
      <%~ it.body %>
    </main>
  </body>
</html>
