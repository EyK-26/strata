<section class="page-header">
  <h1>Outbound webhooks</h1>
  <p class="hint">Signed deliveries use HMAC and <code><%= it.signatureHeader ?? "x-workhub-signature" %></code>.</p>
</section>

<% if (Object.keys(it.errors ?? {}).length > 0) { %>
<div class="form-errors" role="alert">
  <% for (const [field, messages] of Object.entries(it.errors)) { %>
    <% for (const message of messages) { %>
      <p><strong><%= field %></strong>: <%= message %></p>
    <% } %>
  <% } %>
</div>
<% } %>

<form method="post" action="/webhooks" class="stack-form">
  <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
  <label>
    Endpoint URL
    <input type="url" name="url" value="<%= it.old?.url ?? '' %>" required />
  </label>
  <label>
    Shared secret
    <input type="text" name="secret" value="<%= it.old?.secret ?? '' %>" required />
  </label>
  <label>
    Events
    <input type="text" name="events" value="<%= it.old?.events ?? '*' %>" />
  </label>
  <label>
    Team
    <select name="organization_id">
      <option value="" <%= String(it.old?.organization_id ?? it.currentOrganization?.id ?? "") === "" ? "selected" : "" %>>
        All teams
      </option>
      <% for (const organization of it.organizations ?? []) { %>
      <option
        value="<%= organization.id %>"
        <%= String(it.old?.organization_id ?? it.currentOrganization?.id ?? "") === String(organization.id) ? "selected" : "" %>
      >
        <%= organization.name %>
      </option>
      <% } %>
    </select>
  </label>
  <p class="hint">Defaults to your current team. Choose All teams for tenant-wide deliveries.</p>
  <button type="submit">Add webhook</button>
</form>

<section class="card">
  <h2>Endpoints</h2>
  <% if (it.listOrganizationId) { %>
  <p class="hint" id="webhook-list-scope">
    Showing the current team plus All teams endpoints.
    <a href="/webhooks?all=1">View every team</a>
  </p>
  <% } else { %>
  <p class="hint" id="webhook-list-scope">
    Showing every team.
    <a href="/webhooks">Back to current team</a>
  </p>
  <% } %>
  <% if (!it.webhooks?.length) { %>
  <p class="hint">No webhooks registered.</p>
  <% } else { %>
  <table class="data-table">
    <thead>
      <tr>
        <th>URL</th>
        <th>Team</th>
        <th>Events</th>
        <th>Active</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% for (const webhook of it.webhooks) { %>
      <tr>
        <td><code><%= webhook.url %></code></td>
        <td>
          <% if (webhook.organization_id) { %>
          <a href="/organizations/<%= webhook.organization_id %>">
            <%= (it.organizationNames && it.organizationNames[webhook.organization_id]) || ("Team #" + webhook.organization_id) %>
          </a>
          <% } else { %>
          All teams
          <% } %>
        </td>
        <td><%= (webhook.events ?? []).join(", ") %></td>
        <td><%= webhook.active ? "yes" : "no" %></td>
        <td>
          <% if (webhook.active) { %>
          <form method="post" action="/webhooks/<%= webhook.id %>/deactivate">
            <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
            <button type="submit">Deactivate</button>
          </form>
          <% } else { %>
          <form method="post" action="/webhooks/<%= webhook.id %>/activate">
            <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
            <button type="submit">Activate</button>
          </form>
          <% } %>
          <form method="post" action="/webhooks/<%= webhook.id %>/delete">
            <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
            <button type="submit" class="danger-button">Delete</button>
          </form>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } %>
</section>

<section class="card">
  <h2>Recent deliveries</h2>
  <% if (!it.deliveries?.length) { %>
  <p class="hint">No deliveries yet.</p>
  <% } else { %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Webhook</th>
        <th>Event</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% for (const delivery of it.deliveries) { %>
      <tr>
        <td>#<%= delivery.webhook_id %></td>
        <td><%= delivery.event %></td>
        <td><%= delivery.response_status ?? "—" %></td>
        <td>
          <form method="post" action="/webhooks/deliveries/<%= delivery.id %>/retry">
            <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
            <button type="submit">Retry</button>
          </form>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } %>
</section>
