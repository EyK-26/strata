<section class="page-header">
  <h1>Admin resources</h1>
  <p class="hint">Read-only resource browser for global admins.</p>
  <nav class="inline-links">
    <a href="/admin">Dashboard</a>
    <a href="/admin/queue">Queue monitor</a>
    <a href="/admin/audit">Audit log</a>
  </nav>
</section>

<section class="card">
  <table class="data-table">
    <thead>
      <tr>
        <th>Resource</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% for (const resource of it.resources ?? []) { %>
      <tr>
        <td><%= resource.labelPlural %></td>
        <td><a href="/admin/resources/<%= resource.name %>">Browse</a></td>
      </tr>
      <% } %>
    </tbody>
  </table>
</section>
