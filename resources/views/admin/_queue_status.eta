<section class="card">
  <h2>Pending jobs</h2>
  <ul>
    <li>Driver: <code><%= it.queueMetrics.driver %></code></li>
    <li>Pending (high): <%= it.queueMetrics.pending.high %></li>
    <li>Pending (default): <%= it.queueMetrics.pending.default %></li>
    <li>Pending (low): <%= it.queueMetrics.pending.low %></li>
    <li>Pending total: <%= it.queueMetrics.pending.total %></li>
    <li>Failed jobs: <%= it.queueMetrics.failedCount %></li>
  </ul>
</section>

<section class="card">
  <h2>Failed jobs</h2>
  <div id="failed-jobs-panel">
    <%~ include("./_failed_jobs", it) %>
  </div>
</section>
