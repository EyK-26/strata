<section class="page-header">
  <h1><%= it.resource.labelPlural %></h1>
  <nav class="inline-links">
    <a href="/admin/resources">All resources</a>
    <a href="/admin">Dashboard</a>
  </nav>
</section>

<section class="card">
  <table class="data-table">
    <thead>
      <tr>
        <% for (const column of it.resource.columns) { %>
        <th><%= column.label %></th>
        <% } %>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% for (const row of it.rows ?? []) { %>
      <tr>
        <% for (const column of it.resource.columns) { %>
        <td><%= row[column.key] %></td>
        <% } %>
        <td><a href="/admin/resources/<%= it.resource.name %>/<%= row.id %>">View</a></td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <%~ include("./_pagination", { meta: it.meta }) %>
</section>
