<% if (it.meta && it.meta.last_page > 1) { %>
<nav class="pagination">
  <% if (it.meta.page > 1) { %>
  <a href="?page=<%= it.meta.page - 1 %>&per_page=<%= it.meta.per_page %>">Previous</a>
  <% } %>
  <span>Page <%= it.meta.page %> of <%= it.meta.last_page %></span>
  <% if (it.meta.page < it.meta.last_page) { %>
  <a href="?page=<%= it.meta.page + 1 %>&per_page=<%= it.meta.per_page %>">Next</a>
  <% } %>
</nav>
<% } %>
