<section class="page-header">
  <h1>Queue monitor</h1>
  <p class="hint">Pending Redis queue depth and failed job recovery. Refreshes every 5 seconds.</p>
  <nav class="inline-links">
    <a href="/admin">Dashboard</a>
    <a href="/admin/resources">Resources</a>
    <a href="/admin/audit">Audit log</a>
  </nav>
</section>

<div
  id="queue-status-panel"
  hx-get="/admin/queue/status"
  hx-trigger="load, every 5s"
  hx-swap="innerHTML"
>
  <%~ include("./_queue_status", it) %>
</div>
