<table class="data-table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Action</th>
      <th>Subject</th>
      <th>User</th>
      <th>Created</th>
    </tr>
  </thead>
  <tbody>
    <% for (const log of it.auditLogs ?? []) { %>
    <tr>
      <td><%= log.id %></td>
      <td><%= log.action %></td>
      <td><%= log.subject_type %> #<%= log.subject_id ?? "-" %></td>
      <td><%= log.user_id ?? "-" %></td>
      <td><%= log.created_at?.toISOString?.() ?? log.created_at %></td>
    </tr>
    <% } %>
  </tbody>
</table>

<% if (it.auditMeta) { %>
<nav class="pagination" aria-label="Audit log pagination">
  <% if (it.auditMeta.page > 1) { %>
  <a
    href="/admin/audit?page=<%= it.auditMeta.page - 1 %>"
    hx-get="/admin/audit?page=<%= it.auditMeta.page - 1 %>"
    hx-target="#audit-log-table"
    hx-swap="innerHTML"
  >
    Previous
  </a>
  <% } %>
  <span>Page <%= it.auditMeta.page %> of <%= it.auditMeta.last_page %></span>
  <% if (it.auditMeta.page < it.auditMeta.last_page) { %>
  <a
    href="/admin/audit?page=<%= it.auditMeta.page + 1 %>"
    hx-get="/admin/audit?page=<%= it.auditMeta.page + 1 %>"
    hx-target="#audit-log-table"
    hx-swap="innerHTML"
  >
    Next
  </a>
  <% } %>
</nav>
<% } %>
