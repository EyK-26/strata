<section class="page-header">
  <h1><%= it.title %></h1>
  <nav class="inline-links">
    <a href="/admin/resources/<%= it.resource.name %>">Back to list</a>
    <a href="/admin/resources">All resources</a>
  </nav>
</section>

<section class="card">
  <dl class="detail-list">
    <% for (const column of it.resource.columns) { %>
    <dt><%= column.label %></dt>
    <dd><%= it.record[column.key] %></dd>
    <% } %>
  </dl>
</section>
