<ul class="comment-list">
  <% for (const comment of it.comments ?? []) { %>
  <li class="comment-item" id="comment-<%= comment.id %>">
    <form
      hx-patch="/comments/<%= comment.id %>"
      hx-target="#comments-list"
      hx-swap="innerHTML"
      class="stack-form comment-edit-form"
    >
      <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
      <label>
        Comment #<%= comment.id %>
        <textarea name="body" rows="3" required><%= comment.body %></textarea>
      </label>
      <div class="inline-actions">
        <button type="submit">Save</button>
        <button
          type="button"
          hx-delete="/comments/<%= comment.id %>"
          hx-target="#comments-list"
          hx-swap="innerHTML"
          hx-confirm="Delete this comment?"
        >
          Delete
        </button>
      </div>
    </form>
  </li>
  <% } %>
</ul>

<% if ((it.comments ?? []).length === 0) { %>
<p class="hint">No comments yet.</p>
<% } %>
