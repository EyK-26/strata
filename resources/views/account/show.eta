<section class="page-header">
  <h1>Account</h1>
  <p class="hint">Profile, API tokens, data export, email verification, and two-factor authentication for the signed-in session.</p>
</section>

<% if (it.currentOrganization) { %>
<section class="card" id="current-team">
  <h2>Current team</h2>
  <p>
    <a href="/organizations/<%= it.currentOrganization.id %>"><%= it.currentOrganization.name %></a>
    <span class="current-team">Current</span>
  </p>
  <p class="hint">Switch teams from the header Team select or an organization show page.</p>
</section>
<% } %>

<section class="card" id="team-invitations">
  <h2>Team invitations</h2>
  <% if (!it.receivedInvitations?.length) { %>
  <p class="hint">No pending team invitations.</p>
  <% } else { %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Team</th>
        <th>Role</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% for (const invitation of it.receivedInvitations) { %>
      <tr>
        <td>
          <% if (invitation.organization) { %>
          <a href="/organizations/<%= invitation.organization.id %>"><%= invitation.organization.name %></a>
          <% } else { %>
          Team #<%= invitation.organization_id %>
          <% } %>
        </td>
        <td><%= invitation.role %></td>
        <td>
          <form method="post" action="/account/invitations/<%= invitation.id %>/accept">
            <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
            <button type="submit">Accept</button>
          </form>
          <form method="post" action="/account/invitations/<%= invitation.id %>/decline">
            <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
            <button type="submit" class="danger-button">Decline</button>
          </form>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } %>
</section>

<section class="card" id="profile">
  <h2>Profile</h2>
  <form method="post" action="/account/profile" class="stack-form">
    <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
    <label>
      Name
      <input type="text" name="name" value="<%= it.user.name %>" required maxlength="120" />
    </label>
    <label>
      Email
      <input type="email" name="email" value="<%= it.user.email %>" required />
    </label>
    <button type="submit">Update profile</button>
  </form>
</section>

<section class="card" id="profile-photo">
  <h2>Profile photo</h2>
  <% if (it.user.profile_photo_path) { %>
  <p><img src="/account/photo" alt="Profile photo" width="96" height="96" /></p>
  <form method="post" action="/account/photo/delete" class="stack-form">
    <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
    <button type="submit">Remove photo</button>
  </form>
  <% } else { %>
  <p class="hint">No profile photo yet.</p>
  <% } %>
  <form method="post" action="/account/photo" enctype="multipart/form-data" class="stack-form">
    <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
    <label>
      Photo
      <input type="file" name="photo" accept="image/jpeg,image/png,image/gif,image/webp" required />
    </label>
    <button type="submit">Upload photo</button>
  </form>
</section>

<dl class="detail-list">
  <div>
    <dt>Role</dt>
    <dd><%= it.user.role %></dd>
  </div>
  <div>
    <dt>Email verified</dt>
    <dd><%= it.user.email_verified_at ? "Yes" : "No" %></dd>
  </div>
  <div>
    <dt>MFA</dt>
    <dd><%= it.mfaEnabled ? "Enabled" : "Off" %></dd>
  </div>
</dl>

<% if (!it.user.email_verified_at) { %>
<form method="post" action="/account/email/verification-notification" class="stack-form">
  <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
  <button type="submit">Resend verification email</button>
</form>
<% } %>

<% if (Object.keys(it.errors ?? {}).length > 0) { %>
<div class="form-errors" role="alert">
  <% for (const [field, messages] of Object.entries(it.errors)) { %>
    <% for (const message of messages) { %>
    <p><strong><%= field %></strong>: <%= message %></p>
    <% } %>
  <% } %>
</div>
<% } %>

<section class="card">
  <h2>Change password</h2>
  <form method="post" action="/account/password" class="stack-form">
    <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
    <label>
      Current password
      <input type="password" name="current_password" required />
    </label>
    <label>
      New password
      <input type="password" name="password" minlength="8" required />
    </label>
    <button type="submit">Update password</button>
  </form>
</section>

<section class="card">
  <h2>Two-factor authentication</h2>
  <% if (!it.mfaFeatureEnabled) { %>
  <p class="hint">MFA is off for this environment (<code>FEATURE_MFA=false</code>). You can still generate a secret here; login only asks for a code when the flag is on.</p>
  <% } %>

  <% if (it.recoveryCodes?.length) { %>
  <p class="hint">Copy these recovery codes now. Each code works once, and they will not be shown again.</p>
  <ul class="recovery-codes">
    <% for (const code of it.recoveryCodes) { %>
    <li><code><%= code %></code></li>
    <% } %>
  </ul>
  <% } %>

  <% if (it.mfaEnabled) { %>
  <form method="post" action="/account/mfa/recovery-codes" class="stack-form">
    <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
    <label>
      Current password
      <input type="password" name="password" required />
    </label>
    <button type="submit">Generate new recovery codes</button>
  </form>
  <form method="post" action="/account/mfa/disable" class="stack-form">
    <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
    <label>
      Current password
      <input type="password" name="password" required />
    </label>
    <button type="submit" class="danger-button">Turn off MFA</button>
  </form>
  <% } else { %>
  <form method="post" action="/account/mfa" class="stack-form">
    <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
    <button type="submit">Generate authenticator secret</button>
  </form>

  <% if (it.pendingSecret) { %>
  <p class="hint">Scan this otpauth URL or type the secret into an authenticator app, then confirm with a 6-digit code.</p>
  <p><code class="mfa-secret"><%= it.pendingSecret %></code></p>
  <p class="hint"><code><%= it.otpauthUrl %></code></p>
  <form method="post" action="/account/mfa/confirm" class="stack-form">
    <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
    <label>
      MFA code
      <input type="text" name="mfa_code" inputmode="numeric" autocomplete="one-time-code" required />
    </label>
    <button type="submit">Confirm MFA</button>
  </form>
  <% } %>
  <% } %>
</section>

<section class="card" id="api-tokens">
  <h2>API tokens</h2>
  <p class="hint">Personal access tokens for the JSON API. The plaintext secret is shown only once after you create it.</p>

  <% if (it.plainToken) { %>
  <p class="hint">Copy this token now. It will not be shown again.</p>
  <p><code class="plain-token"><%= it.plainToken %></code></p>
  <% } %>

  <form method="post" action="/account/tokens" class="stack-form">
    <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
    <label>
      Token name
      <input type="text" name="name" maxlength="120" required />
    </label>
    <label>
      Expires in days (optional)
      <input type="number" name="expires_in_days" min="1" max="3650" />
    </label>
    <fieldset>
      <legend>Abilities</legend>
      <p class="hint">Leave all unchecked for the same abilities as this session. You cannot grant abilities you do not have.</p>
      <% for (const ability of it.availableAbilities ?? []) { %>
      <label class="checkbox">
        <input type="checkbox" name="ability:<%= ability %>" value="1" />
        <code><%= ability %></code>
      </label>
      <% } %>
    </fieldset>
    <button type="submit">Create token</button>
  </form>

  <% if (!it.tokens?.length) { %>
  <p class="hint">No API tokens yet.</p>
  <% } else { %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Abilities</th>
        <th>Created</th>
        <th>Expires</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% for (const token of it.tokens) { %>
      <tr>
        <td><%= token.name %></td>
        <td><code><%= (token.abilities ?? []).join(", ") %></code></td>
        <td><%= token.created_at %></td>
        <td><%= token.expires_at ?? "Never" %></td>
        <td>
          <form method="post" action="/account/tokens/<%= token.id %>/revoke">
            <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
            <button type="submit" class="danger-button">Revoke</button>
          </form>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } %>

  <div id="browser-sessions">
    <h3>Browser sessions</h3>
    <p class="hint">HMAC login writes a <code>sessions</code> row (user agent and IP) so this list can mark This device. <code>SessionGuard</code> rejects a cookie after that row is deleted. Cookie-store sessions from sibling HTMX apps appear here too.</p>
    <% if (!it.browserSessions?.length) { %>
    <p class="hint">No active browser sessions recorded yet.</p>
    <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Browser</th>
          <th>IP</th>
          <th>Last active</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% for (const session of it.browserSessions) { %>
        <tr data-current-session="<%= session.current ? "1" : "0" %>" data-session-id="<%= session.id %>">
          <td><%= session.user_agent ?? "Unknown browser" %></td>
          <td><%= session.ip_address ?? "Unknown IP" %></td>
          <td><%= session.last_active_at ?? session.expires_at %></td>
          <td>
            <% if (session.current) { %>
            This device
            <% } else { %>
            <form method="post" action="/account/sessions/<%= session.id %>/logout">
              <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
              <button type="submit" class="link-button">Log out</button>
            </form>
            <% } %>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
    <% } %>
  </div>

  <form method="post" action="/account/logout-other-devices" class="stack-form">
    <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
    <p class="hint">Revoke every API token except the one used by this request (HMAC login has no bearer, so all tokens are revoked). Older HMAC cookies fail <code>SessionGuard</code> after <code>users.session_valid_after</code>; this browser stays signed in because the handler re-issues the session cookie and drops other <code>sessions</code> rows.</p>
    <label>
      Current password
      <input type="password" name="password" required />
    </label>
    <button type="submit" class="danger-button">Log out other devices</button>
  </form>
</section>

<section class="card" id="data-privacy">
  <h2>Your data</h2>
  <p class="hint">Download a JSON copy of your profile, API tokens, and OAuth identities. Export and delete ask you to confirm your password first. Deleting the account anonymizes your user row and revokes tokens.</p>
  <p><a href="/account/export">Export my data</a></p>

  <form method="post" action="/account/delete" class="stack-form">
    <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
    <label>
      Current password
      <input type="password" name="password" required />
    </label>
    <label>
      Type DELETE to confirm
      <input type="text" name="confirm" autocomplete="off" required />
    </label>
    <button type="submit" class="danger-button">Delete account</button>
  </form>
</section>
