<% if (!it.attachments?.length) { %>
<p class="hint">No attachments yet.</p>
<% } else { %>
<ul class="attachment-list">
  <% it.attachments.forEach(function (attachment) { %>
  <li>
    <a href="<%= attachment.downloadUrl ?? `/attachments/${attachment.id}/download` %>"><%= attachment.original_name %></a>
    <span class="hint">(<%= attachment.mime_type %>, <%= attachment.size_bytes %> bytes)</span>
    <button
      type="button"
      class="link-button"
      hx-delete="/attachments/<%= attachment.id %>"
      hx-target="#attachments-list"
      hx-swap="innerHTML"
    >
      Remove
    </button>
  </li>
  <% }) %>
</ul>
<% } %>
