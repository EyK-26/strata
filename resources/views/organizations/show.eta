<section class="page-header">
  <h1>
    <%= it.organization.name %>
    <% if (it.isCurrentTeam) { %>
    <span class="current-team">Current</span>
    <% } %>
  </h1>
  <p class="hint"><code><%= it.organization.slug %></code></p>
  <% if (it.isCurrentTeam) { %>
  <p class="hint">This is your current team.</p>
  <% } else if (it.canSwitchToTeam) { %>
  <form method="post" action="/current-organization" class="nav-org">
    <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
    <input type="hidden" name="organization_id" value="<%= it.organization.id %>" />
    <button type="submit">Switch to this team</button>
  </form>
  <% } %>
</section>

<dl class="detail-list">
  <div>
    <dt>ID</dt>
    <dd><%= it.organization.id %></dd>
  </div>
  <div>
    <dt>Created</dt>
    <dd><%= it.organization.created_at.toISOString?.() ?? it.organization.created_at %></dd>
  </div>
  <div>
    <dt>Updated</dt>
    <dd><%= it.organization.updated_at.toISOString?.() ?? it.organization.updated_at %></dd>
  </div>
</dl>

<form method="post" action="/organizations/<%= it.organization.id %>" class="stack-form">
  <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
  <label>
    Name
    <input type="text" name="name" value="<%= it.old?.name ?? it.organization.name %>" required />
  </label>
  <label>
    Slug
    <input type="text" name="slug" value="<%= it.old?.slug ?? it.organization.slug %>" required />
  </label>
  <button type="submit">Save organization</button>
</form>

<%~ include('../organizations/_members', it) %>

<form method="post" action="/organizations/<%= it.organization.id %>/delete" class="stack-form">
  <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
  <button
    type="submit"
    class="danger-button"
    hx-delete="/organizations/<%= it.organization.id %>"
    hx-confirm="Delete this organization?"
  >
    Delete organization
  </button>
</form>

<p><a href="/organizations">← Back to organizations</a></p>

<section
  class="htmx-demo"
  hx-get="/organizations"
  hx-trigger="revealed"
  hx-select="#org-table"
  hx-swap="outerHTML"
>
  <p class="hint">HTMX preview loads when this section scrolls into view.</p>
</section>
