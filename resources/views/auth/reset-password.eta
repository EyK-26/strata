<section class="page-header">
  <h1>Choose a new password</h1>
  <p class="hint">This form is bound to a temporary signed URL.</p>
</section>

<% if (Object.keys(it.errors ?? {}).length > 0) { %>
<div class="form-errors" role="alert">
  <% for (const [field, messages] of Object.entries(it.errors)) { %>
    <% for (const message of messages) { %>
      <p><strong><%= field %></strong>: <%= message %></p>
    <% } %>
  <% } %>
</div>
<% } %>

<form method="post" action="/reset-password?email=<%= encodeURIComponent(it.email ?? '') %>&token=<%= encodeURIComponent(it.token ?? '') %>&expires=<%= encodeURIComponent(it.expires ?? '') %>&signature=<%= encodeURIComponent(it.signature ?? '') %>" class="stack-form">
  <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
  <input type="hidden" name="email" value="<%= it.email ?? '' %>" />
  <input type="hidden" name="token" value="<%= it.token ?? '' %>" />
  <label>
    New password
    <input type="password" name="password" minlength="8" required />
  </label>
  <button type="submit">Update password</button>
</form>
