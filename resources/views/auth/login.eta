<section class="page-header">
  <h1>Sign in</h1>
  <p class="hint">Use a seeded WorkHub account such as admin@workhub.test / password.</p>
</section>

<% if (Object.keys(it.errors ?? {}).length > 0) { %>
<div class="form-errors" role="alert">
  <% for (const [field, messages] of Object.entries(it.errors)) { %>
    <% for (const message of messages) { %>
      <p><strong><%= field %></strong>: <%= message %></p>
    <% } %>
  <% } %>
</div>
<% } %>

<form method="post" action="/login" class="stack-form">
  <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
  <input type="hidden" name="redirect" value="<%= it.redirect ?? '/organizations' %>" />

  <label>
    Email
    <input type="email" name="email" value="<%= it.old?.email ?? '' %>" required />
  </label>

  <label>
    Password
    <input type="password" name="password" required />
  </label>

  <button type="submit">Sign in</button>
</form>
