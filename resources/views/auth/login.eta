<section class="page-header">
  <h1>Sign in</h1>
  <p class="hint">Use a seeded WorkHub account such as admin@workhub.test / password.</p>
</section>

<% if (Object.keys(it.errors ?? {}).length > 0) { %>
<div class="form-errors" role="alert">
  <% for (const [field, messages] of Object.entries(it.errors)) { %>
    <% for (const message of messages) { %>
      <p><strong><%= field %></strong>: <%= message %></p>
    <% } %>
  <% } %>
</div>
<% } %>

<form method="post" action="/login" class="stack-form">
  <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
  <input type="hidden" name="redirect" value="<%= it.redirect ?? '/organizations' %>" />

  <label>
    Email
    <input type="email" name="email" value="<%= it.old?.email ?? '' %>" required />
  </label>

  <label>
    Password
    <input type="password" name="password" required />
  </label>

  <label>
    MFA or recovery code (optional)
    <input type="text" name="mfa_code" autocomplete="one-time-code" />
  </label>
  <p class="hint">If this account uses MFA and you leave this blank, WorkHub sends you to /two-factor-challenge.</p>

  <label>
    <input type="checkbox" name="remember" value="1" />
    Remember me
  </label>

  <button type="submit">Sign in</button>
</form>

<% if (it.providers?.length) { %>
<div class="oauth-providers">
  <p class="hint">Or continue with a provider</p>
  <% for (const provider of it.providers) { %>
  <p>
    <a href="/oauth/<%= provider.name %>?redirect=<%= encodeURIComponent(it.redirect ?? '/organizations') %>">
      Sign in with <%= provider.label %>
    </a>
  </p>
  <% } %>
</div>
<% } %>

<p class="hint"><a href="/forgot-password">Forgot your password?</a></p>
<% if (it.registrationEnabled) { %>
<p class="hint"><a href="/register<%= it.redirect && it.redirect !== '/organizations' ? `?redirect=${encodeURIComponent(it.redirect)}` : "" %>">Create an account</a></p>
<% } %>

<form method="post" action="/email/verification-notification" class="stack-form">
  <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
  <p class="hint">Need a new verification link?</p>
  <label>
    Email
    <input type="email" name="email" value="<%= it.old?.email ?? '' %>" />
  </label>
  <button type="submit">Resend verification</button>
</form>
