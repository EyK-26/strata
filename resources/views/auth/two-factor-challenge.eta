<section class="page-header">
  <h1>Two-factor authentication</h1>
  <p class="hint">Enter an authenticator code or a one-time recovery code to finish signing in.</p>
</section>

<% if (Object.keys(it.errors ?? {}).length > 0) { %>
<div class="form-errors" role="alert">
  <% for (const [field, messages] of Object.entries(it.errors)) { %>
    <% for (const message of messages) { %>
      <p><strong><%= field %></strong>: <%= message %></p>
    <% } %>
  <% } %>
</div>
<% } %>

<form method="post" action="/two-factor-challenge" class="stack-form">
  <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
  <input type="hidden" name="redirect" value="<%= it.redirect ?? '/organizations' %>" />

  <label>
    MFA or recovery code
    <input type="text" name="mfa_code" autocomplete="one-time-code" required />
  </label>

  <button type="submit">Continue</button>
</form>

<p class="hint"><a href="/login">Back to sign in</a></p>
