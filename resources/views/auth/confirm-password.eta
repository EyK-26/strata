<section class="page-header">
  <h1>Confirm your password</h1>
  <p class="hint">This is a sensitive action. Enter your password to continue.</p>
</section>

<% if (Object.keys(it.errors ?? {}).length > 0) { %>
<div class="form-errors" role="alert">
  <% for (const [field, messages] of Object.entries(it.errors)) { %>
    <% for (const message of messages) { %>
      <p><strong><%= field %></strong>: <%= message %></p>
    <% } %>
  <% } %>
</div>
<% } %>

<form method="post" action="/confirm-password" class="stack-form">
  <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
  <input type="hidden" name="redirect" value="<%= it.redirect ?? '/account' %>" />

  <label>
    Password
    <input type="password" name="password" required autocomplete="current-password" />
  </label>

  <button type="submit">Confirm password</button>
</form>
