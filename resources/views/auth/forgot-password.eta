<section class="page-header">
  <h1>Forgot password</h1>
  <p class="hint">We send a signed reset link if that email exists. The link expires in 60 minutes.</p>
</section>

<% if (it.sent) { %>
<div class="flash flash-success" role="status">
  If an account exists for that address, a reset email is on its way.
</div>
<% } %>

<% if (Object.keys(it.errors ?? {}).length > 0) { %>
<div class="form-errors" role="alert">
  <% for (const [field, messages] of Object.entries(it.errors)) { %>
    <% for (const message of messages) { %>
      <p><strong><%= field %></strong>: <%= message %></p>
    <% } %>
  <% } %>
</div>
<% } %>

<form method="post" action="/forgot-password" class="stack-form">
  <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
  <label>
    Email
    <input type="email" name="email" value="<%= it.old?.email ?? '' %>" required />
  </label>
  <button type="submit">Send reset link</button>
</form>

<p><a href="/login">← Back to sign in</a></p>
