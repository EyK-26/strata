<div id="notifications-inbox" class="notifications-inbox">
  <button type="button" class="notifications-toggle" aria-expanded="false" aria-haspopup="true">
    Inbox<% if (it.unreadCount) { %> (<%= it.unreadCount %>)<% } %>
  </button>
  <div class="notifications-panel">
    <% if (!it.notifications?.length) { %>
    <p class="hint">No notifications yet.</p>
    <% } else { %>
    <ul class="notification-list">
      <% for (const notification of it.notifications) { %>
      <li class="<%= notification.read_at ? "is-read" : "is-unread" %>">
        <strong><%= notification.title %></strong>
        <p><%= notification.body %></p>
        <% if (!notification.read_at) { %>
        <button
          type="button"
          class="link-button"
          hx-post="/notifications/<%= notification.id %>/read"
          hx-target="#notifications-bell"
          hx-swap="innerHTML"
        >
          Mark read
        </button>
        <% } %>
      </li>
      <% } %>
    </ul>
    <form
      method="post"
      action="/notifications/read-all"
      hx-post="/notifications/read-all"
      hx-target="#notifications-bell"
      hx-swap="innerHTML"
    >
      <input type="hidden" name="_token" value="<%= it.csrfToken ?? "" %>" />
      <button type="submit" class="link-button">Mark all read</button>
    </form>
    <% } %>
  </div>
</div>
