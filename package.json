{
  "name": "bun-testing",
  "module": "src/bootstrap/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/bootstrap/server.ts",
    "check": "tsc --noEmit",
    "unit": "bun test tests/unit",
    "integration": "bun test ./tests/integration/routes.integration.test.ts ./tests/integration/queue.integration.test.ts",
    "test:all": "QUEUE_DRIVER=sync bun run unit && QUEUE_DRIVER=sync bun run integration",
    "openapi:validate": "bun run cli openapi:validate",
    "smoke": "sh scripts/smoke-test.sh",
    "cli": "bun run src/cli/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  }
}
